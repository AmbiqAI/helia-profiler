+def _make_tree_owner_writable(tree: Path) -> None:
+    """Make a packaged Nix-store copy usable as an app-local work tree."""
+
+    if tree.is_symlink():
+        return
+    tree.chmod(tree.stat().st_mode | 0o700)
+    for path in tree.rglob("*"):
+        if path.is_symlink():
+            continue
+        if path.is_dir():
+            path.chmod(path.stat().st_mode | 0o700)
+        else:
+            path.chmod(path.stat().st_mode | 0o600)
+
