{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambiqai.github.io/helia-benchmark/contracts/results/v1/result.schema.json",
  "title": "Helia portable result view (draft v1)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0-draft"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "helia-profiler",
            "helia-estimator"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "mapping_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "revision",
        "mapping_version"
      ],
      "additionalProperties": false
    },
    "native_result": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "required": [
        "schema",
        "identity",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "input_identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "state_policy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "name",
        "model_identity",
        "input_identity",
        "state_policy"
      ],
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "name",
        "identity"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "status",
        "stage",
        "reason"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "verifier",
        "checks",
        "limitations"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "native_result",
    "workload",
    "engine",
    "target",
    "outcome",
    "observations",
    "verification"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "id",
        "role",
        "location",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "cpu",
            "npu",
            "system",
            "memory"
          ]
        },
        "origin": {
          "enum": [
            "measured",
            "simulated",
            "estimated",
            "derived",
            "reported"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "statistic": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "extensions": {
          "type": "object"
        },
        "basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/basis"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "metric",
        "unit",
        "domain",
        "origin",
        "scope",
        "statistic",
        "value",
        "unavailable_reason",
        "sample_count",
        "evidence",
        "basis"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            },
            "unavailable_reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "value": {
              "type": "null"
            },
            "unavailable_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        }
      },
      "required": [
        "artifact",
        "pointer"
      ],
      "additionalProperties": false
    },
    "basis": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "reported",
            "configured",
            "counter",
            "compiler_estimate",
            "model_estimate",
            "derived"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "transformation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "clocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "configured",
                  "reported",
                  "observed"
                ]
              },
              "value_hz": {
                "type": "integer",
                "minimum": 1
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            },
            "required": [
              "role",
              "value_hz",
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "sources",
        "transformation"
      ],
      "additionalProperties": false
    }
  }
}
