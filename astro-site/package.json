{
  "name": "heliaprofiler-site",
  "description": "Astro Starlight documentation for heliaPROFILER",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "prepare:docs": "node scripts/build-info.mjs",
    "predev": "npm run prepare:docs",
    "dev": "astro dev",
    "prebuild": "npm run prepare:docs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run prepare:docs",
    "check": "astro check",
    "check:links": "python3 scripts/check-site-links.py",
    "check:output": "node scripts/check-output.mjs && helia-ui-check-discoverability --root .",
    "check:search": "node scripts/check-search.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:guard": "node --test scripts/deploy-guard.test.mjs",
    "legacy-routes:extract": "node scripts/extract-legacy-routes.mjs"
  },
  "dependencies": {
    "@ambiqai/helia-ui": "github:AmbiqAI/helia-ui#v0.1.0-alpha.14",
    "@astrojs/starlight": "^0.41.5",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "^7.0.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3"
  }
}
