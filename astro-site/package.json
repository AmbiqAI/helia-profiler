{
  "name": "heliaprofiler-site",
  "description": "Astro Starlight documentation for heliaPROFILER",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "prepare:docs": "node scripts/build-info.mjs && npm run reference:dump && npm run reference:build && npm run cli-reference:build",
    "reference:dump": "node scripts/dump-python.mjs",
    "reference:build": "node scripts/build-reference.mjs",
    "cli-reference:build": "node scripts/build-cli-reference.mjs",
    "predev": "npm run prepare:docs",
    "dev": "astro dev",
    "prebuild": "npm run prepare:docs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run prepare:docs",
    "check": "astro check",
    "check:links": "python3 scripts/check-site-links.py",
    "check:output": "node scripts/check-output.mjs && node scripts/check-reference-output.mjs && node scripts/check-cli-reference-output.mjs && helia-ui-check-discoverability --root .",
    "check:search": "node scripts/check-search.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:reference": "node scripts/check-committed-artifacts.mjs && node scripts/check-reference-stale.mjs && node scripts/check-cli-reference-stale.mjs",
    "check:port": "node scripts/check-legacy-port.mjs",
    "check:guard": "node --test scripts/*.test.mjs",
    "legacy-routes:extract": "node scripts/extract-legacy-routes.mjs",
    "docs:port": "node scripts/port-legacy-docs.mjs"
  },
  "dependencies": {
    "@ambiqai/helia-ui": "github:AmbiqAI/helia-ui#v0.1.0-alpha.16",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "^0.41.5",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.3",
    "playwright": "1.63.0",
    "rehype-mermaid": "3.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3"
  }
}
