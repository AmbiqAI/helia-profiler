---
/**
 * The version and source commit this site was built from.
 *
 * Local rather than shared: helia-ui's Starlight shell has no version slot, so
 * until that lands upstream each product carries its own. The build-info import
 * is what ties the string on the page to the artifact the deploy guard reads.
 */
import Badge from '@ambiqai/helia-ui/astro/Badge';
import buildInfo from '../data/build-info.json';
---

<p class="docs-version">
  <Badge tone="info" size="md">{buildInfo.display}</Badge>
  <a href={buildInfo.sourceUrl}>Source commit {buildInfo.shortCommit}</a>
</p>

<style>
  .docs-version {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
</style>
