---
/**
 * The heliaPROFILER wordmark, picked by theme.
 *
 * Local because helia-ui has no theme-selected image part at
 * v0.1.0-alpha.16; listed as an upstream candidate on AmbiqAI/helia-profiler#335.
 *
 * Both files ship and CSS hides one. The MkDocs source selected them with
 * Material's `#only-light` / `#only-dark` URL fragments, which are a Material
 * stylesheet convention: Astro treats them as part of the URL, so both images
 * would render. `data-theme` is what the shell actually sets, and it is set
 * before paint, so neither image flashes.
 *
 * Both images carry the same `alt`. `display: none` takes the hidden one out
 * of the accessibility tree along with the layout, so exactly one wordmark is
 * announced whichever theme is live, and the announced one is the visible one.
 *
 * The sources live in `src/assets/` rather than `public/` so `astro:assets`
 * resamples them to the width this slot actually paints. Served straight out
 * of `public/` the pair is the full 1710px original, which is an order of
 * magnitude more bytes than the page draws.
 */
import { Image } from 'astro:assets';
import lightLogo from '../assets/heliaprofiler-logo-light.png';
import darkLogo from '../assets/heliaprofiler-logo-dark.png';

interface Props {
  /** Painted width of the wordmark. The rendered asset is twice this, for 2x. */
  width?: string;
}

const { width = '15rem' } = Astro.props;

/* 480 is 15rem at 2x. The CSS width is what the page paints; this is what the
 * file holds, so the wordmark stays sharp on a retina screen. */
const RENDERED_WIDTH = 480;
---

<p class="product-logo" style={`--product-logo-width: ${width}`}>
  <Image
    class="product-logo__img product-logo__img--light"
    src={lightLogo}
    alt="heliaPROFILER"
    width={RENDERED_WIDTH}
    densities={[1]}
  />
  <Image
    class="product-logo__img product-logo__img--dark"
    src={darkLogo}
    alt="heliaPROFILER"
    width={RENDERED_WIDTH}
    densities={[1]}
  />
</p>

<style>
  .product-logo {
    margin: 0;
  }

  .product-logo__img {
    width: var(--product-logo-width);
    height: auto;
    max-width: 100%;
  }

  :root[data-theme='dark'] .product-logo__img--light,
  .product-logo__img--dark {
    display: none;
  }

  :root[data-theme='dark'] .product-logo__img--dark {
    display: inline;
  }
</style>
