---
/*
 * A page rather than a content entry, so the discoverability integration never
 * sees it. That integration walks the docs collection: a 404 left in there
 * gets an llms.txt line and a /404/index.md rendition, both naming a route the
 * site does not serve, and Starlight's canonical on the page names that same
 * missing route.
 *
 * StarlightPage gives the shell without the collection membership.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Button from '@ambiqai/helia-ui/astro/Button';
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'Find the heliaPROFILER documentation you need.',
    template: 'splash',
    tableOfContents: false,
    /* Starlight would otherwise point the canonical at /404/, which is the
     * route this page would have had as a content entry and which the site
     * does not serve. Its own URL is the one that exists. */
    head: [
      { tag: 'meta', attrs: { name: 'robots', content: 'noindex' } },
      {
        tag: 'link',
        attrs: {
          rel: 'canonical',
          href: 'https://ambiqai.github.io/helia-profiler/404.html',
        },
      },
    ],
  }}
  hasSidebar={false}
>
  <p>
    We could not find that page. It may have moved during the documentation
    migration.
  </p>
  <p>Use search to find a topic, or continue below.</p>
  <p>
    <Button href="/helia-profiler/">Go to Home</Button>{' '}
    <Button href="/helia-profiler/reference/" variant="secondary">Reference</Button>
  </p>
</StarlightPage>
