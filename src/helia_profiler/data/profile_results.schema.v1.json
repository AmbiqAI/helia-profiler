{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambiqai.github.io/helia-profiler/schemas/profile-results/v1.json",
  "title": "heliaPROFILER profile results",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "metadata",
    "summary",
    "layers",
    "presets",
    "overflow_detected"
  ],
  "properties": {
    "schema": {
      "const": "hpx.profile-results"
    },
    "schema_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "presets": {
      "type": "object",
      "additionalProperties": true
    },
    "overflow_detected": {
      "type": "boolean"
    },
    "power": {
      "type": "object",
      "additionalProperties": true
    },
    "transfer_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transfer_evidence"
      }
    },
    "transfer_diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transfer_diagnostic"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "transfer_stats": {
      "type": "object",
      "required": [
        "issues",
        "waits",
        "aborts",
        "peak_in_flight",
        "wait_checks_max",
        "unsampled"
      ],
      "properties": {
        "issues": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "waits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "aborts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "peak_in_flight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "wait_checks_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "unsampled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "transfer_activity": {
      "type": "object",
      "required": [
        "dma_in_progress",
        "reads_pending"
      ],
      "properties": {
        "dma_in_progress": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reads_pending": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "transfer_evidence": {
      "type": "object",
      "required": [
        "preset",
        "iteration"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "iteration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stats": {
          "$ref": "#/$defs/transfer_stats"
        },
        "overlap": {
          "type": "object",
          "required": [
            "units",
            "operators"
          ],
          "properties": {
            "units": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/transfer_activity"
              }
            },
            "operators": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/transfer_activity"
              }
            }
          },
          "additionalProperties": false
        },
        "refills": {
          "type": "object",
          "required": [
            "units",
            "operators"
          ],
          "properties": {
            "units": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "operators": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "stats"
          ]
        },
        {
          "required": [
            "overlap"
          ]
        },
        {
          "required": [
            "refills"
          ]
        }
      ]
    },
    "transfer_unit_timing": {
      "type": "object",
      "required": [
        "unit",
        "issue_cycles",
        "issue_status",
        "wait_cycles",
        "wait_status"
      ],
      "properties": {
        "unit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "issue_cycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "issue_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "wait_cycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "wait_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "transfer_diagnostic": {
      "type": "object",
      "required": [
        "purpose",
        "iteration",
        "cpu_hz",
        "preparation",
        "elapsed_cycles",
        "run_status",
        "complete",
        "units",
        "stats"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "timing",
            "overlap",
            "trace"
          ]
        },
        "iteration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cpu_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "preparation": {
          "enum": [
            "configured",
            "cold"
          ]
        },
        "elapsed_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "run_status": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "complete": {
          "type": "boolean"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transfer_unit_timing"
          }
        },
        "stats": {
          "$ref": "#/$defs/transfer_stats"
        },
        "overlap": {
          "type": "object",
          "required": [
            "units",
            "operators"
          ],
          "properties": {
            "units": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/transfer_activity"
              }
            },
            "operators": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/transfer_activity"
              }
            }
          },
          "additionalProperties": false
        },
        "trace": {
          "$ref": "#/$defs/transfer_trace"
        }
      },
      "additionalProperties": false
    },
    "transfer_trace_span": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "start_cycles",
        "end_cycles",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "issue",
            "wait",
            "operator"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "start_cycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "end_cycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "transfer_completion": {
      "type": "object",
      "required": [
        "sequence",
        "ticket",
        "byte_count",
        "status",
        "cycles"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ticket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "transfer_trace": {
      "type": "object",
      "required": [
        "binding_epoch",
        "sequence_start",
        "capacity",
        "storage_bytes",
        "operator_count",
        "observed_count",
        "dropped_count",
        "clock_valid",
        "quiescent",
        "spans",
        "completions",
        "schema",
        "schema_version"
      ],
      "properties": {
        "binding_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "sequence_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "storage_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "operator_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "dropped_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "clock_valid": {
          "type": "boolean"
        },
        "quiescent": {
          "type": "boolean"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transfer_trace_span"
          }
        },
        "completions": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/transfer_completion"
          }
        },
        "schema": {
          "const": "hpx.transfer-trace"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
