{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambiqai.github.io/helia-profiler/schemas/calibration/v2.json",
  "title": "heliaPROFILER calibration file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "conditions", "operator_cycles", "capture"],
  "properties": {
    "schema_version": {"const": 2},
    "model": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "subgraph"],
      "properties": {"sha256": {"type": "string", "minLength": 1}, "subgraph": {"type": "integer", "minimum": 0}}
    },
    "conditions": {
      "type": "object", "required": ["target", "weights_memory"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "cpu_hz": {"type": ["integer", "null"]},
        "weights_memory": {"type": "string"},
        "weights_cache": {"type": "string"},
        "external_memory_clock": {"type": ["integer", "null"]},
        "application_load": {"type": "string"}
      }
    },
    "operator_cycles": {
      "type": "object",
      "additionalProperties": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false, "required": ["knobs", "cycles", "facts"],
          "properties": {
            "knobs": {"$ref": "#/$defs/strings"},
            "cycles": {"type": "number", "minimum": 0},
            "facts": {"$ref": "#/$defs/facts"}
          }
        }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["setup"],
      "properties": {
        "setup": {
          "type": "object", "additionalProperties": false,
          "required": ["digest", "fields", "pairing_digest", "pairing_fields", "helia_aot_version"],
          "properties": {
            "digest": {"$ref": "#/$defs/sha256"},
            "fields": {"$ref": "#/$defs/names"},
            "pairing_digest": true,
            "pairing_fields": true,
            "helia_aot_version": {"type": ["string", "null"]}
          },
          "oneOf": [
            {"properties": {"pairing_digest": {"type": "null"}, "pairing_fields": {"type": "null"}}},
            {"properties": {"pairing_digest": {"$ref": "#/$defs/sha256"}, "pairing_fields": {"$ref": "#/$defs/names"}}}
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "names": {"type": "array", "items": {"type": "string"}},
    "strings": {"type": "object", "additionalProperties": {"type": "string"}},
    "facts": {
      "type": "object", "propertyNames": {"pattern": "^(fixed:.+|kernel:entry)$"},
      "additionalProperties": {"type": "string"}
    }
  }
}
