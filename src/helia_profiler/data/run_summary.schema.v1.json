{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambiqai.github.io/helia-profiler/schemas/run-summary/v1.json",
  "title": "heliaPROFILER run summary",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "engine",
    "layers",
    "total_cycles",
    "overflow_detected",
    "validity",
    "issues"
  ],
  "properties": {
    "schema": {"const": "hpx.run-summary"},
    "schema_version": {"const": 19},
    "engine": {"type": "string", "minLength": 1},
    "layers": {"type": "integer", "minimum": 0},
    "total_cycles": {"type": ["number", "null"]},
    "overflow_detected": {"type": "boolean"},
    "validity": {"enum": ["valid", "degraded", "invalid"]},
    "issues": {"type": "array", "items": {"type": "object"}},
    "identity": {
      "type": "object",
      "required": [
        "runtime",
        "kernels",
        "prepared_archive_sha256",
        "build",
        "baseline_id",
        "dependency_lock_sha256",
        "model_sha256",
        "inputs_hash",
        "run",
        "producer",
        "build_hash",
        "observation_hash",
        "intent_hash"
      ],
      "properties": {
        "build_hash": {
          "oneOf": [
            {"type": "string", "pattern": "^hpx\\.build/1:sha256:[0-9a-f]{64}$"},
            {"type": "object", "required": ["unknown"], "properties": {"unknown": {"type": "string"}}, "additionalProperties": false}
          ]
        },
        "inputs_hash": {
          "oneOf": [
            {"type": "string", "pattern": "^hpx\\.inputs/1:sha256:[0-9a-f]{64}$"},
            {"type": "object", "required": ["unknown"], "properties": {"unknown": {"type": "string"}}, "additionalProperties": false}
          ]
        },
        "observation_hash": {
          "oneOf": [
            {"type": "string", "pattern": "^hpx\\.observation/1:sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "intent_hash": {
          "oneOf": [
            {"type": "string", "pattern": "^hpx\\.intent/1:sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
