{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambiqai.github.io/helia-profiler/schemas/run-summary/v1.json",
  "title": "heliaPROFILER run summary",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "engine",
    "layers",
    "total_cycles",
    "overflow_detected",
    "validity",
    "issues"
  ],
  "properties": {
    "schema": {"const": "hpx.run-summary"},
    "schema_version": {"const": 18},
    "engine": {"type": "string", "minLength": 1},
    "layers": {"type": "integer", "minimum": 0},
    "total_cycles": {"type": ["number", "null"]},
    "overflow_detected": {"type": "boolean"},
    "validity": {"enum": ["valid", "degraded", "invalid"]},
    "issues": {"type": "array", "items": {"type": "object"}},
    "identity": {
      "type": "object",
      "required": [
        "runtime",
        "kernels",
        "prepared_archive_sha256",
        "build",
        "baseline_id",
        "dependency_lock_sha256",
        "model_sha256",
        "inputs_sha256",
        "run",
        "producer",
        "build_hash",
        "observation_hash",
        "intent_hash"
      ]
    }
  },
  "additionalProperties": true
}
