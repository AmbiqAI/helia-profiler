#include <cstdint>
#include <cstring>
#if defined(__ARM_FEATURE_MVE)
#include <arm_mve.h>
#endif
#include "apollo510.h"
#include "nsx_system.h"
#include "nsx_core.h"
#include "nsx_mem.h"
#include "am_hal_pwrctrl.h"
#include "fixed_fixture_clock.h"
{% if fixture_aot %}
#include "{{ aot_prefix }}_model.h"
#include "{{ aot_prefix }}_common.h"
{% else %}
#include "fixed_fixture_memory.h"
#include "model_data.h"
#include "tensorflow/lite/micro/micro_interpreter.h"
#include "tensorflow/lite/micro/micro_mutable_op_resolver.h"
#include "tensorflow/lite/schema/schema_generated.h"
{% endif %}

static const uint8_t fixed_input[] = { {{ input_values }} };
{% if not fixture_aot %}
NSX_MEM_SRAM_BSS alignas(16) static uint8_t arena[{{ fixture_arena_size }}];
{% endif %}
volatile int32_t deployment_status = -1;
volatile uint8_t deployment_output[{{ output_tensor.size }}];
volatile uint32_t deployment_checksum;
volatile uint32_t deployment_timing[7];

static int infer_fixture() {
{% if fixture_aot %}
    {{ aot_prefix }}_model_context_t model_ctx = {};
    if ({{ aot_prefix }}_model_init(&model_ctx) != 0) return {{ fixture_status.arena }};
    if ({{ aot_prefix }}_num_inputs != 1 || {{ aot_prefix }}_num_outputs != 1 ||
        model_ctx.inputs[0].size != {{ input_tensor.size }} || model_ctx.outputs[0].size != {{ output_tensor.size }} ||
        !model_ctx.inputs[0].data || !model_ctx.outputs[0].data) return {{ fixture_status.io_contract }};
    auto *input_data = model_ctx.inputs[0].data;
    auto *output_data = reinterpret_cast<const uint8_t *>(model_ctx.outputs[0].data);
    auto invoke = [&]() { return {{ aot_prefix }}_model_run(&model_ctx); };
{% else %}
    hpx_fixture_memory_init(sizeof(arena));
    tflite::MicroMutableOpResolver<{{ fixture_resolver.max_ops }}> resolver;
{% for registration in fixture_registrations %}
    if (resolver.{{ registration }} != kTfLiteOk) return {{ fixture_status.resolver }};
{% endfor %}
    const auto *model = tflite::GetModel(model_data);
    if (model->version() != TFLITE_SCHEMA_VERSION || model->subgraphs()->size() != 1) return {{ fixture_status.model_schema }};
    const auto *graph = model->subgraphs()->Get(0);
    if (graph->inputs()->size() != 1 || graph->outputs()->size() != 1) return {{ fixture_status.io_contract }};
    tflite::MicroInterpreter interpreter(model, resolver, arena, sizeof(arena));
    if (interpreter.AllocateTensors() != kTfLiteOk) return {{ fixture_status.arena }};
    auto *input = interpreter.input(0);
    auto *output = interpreter.output(0);
{% for name, tensor in [('input', input_tensor), ('output', output_tensor)] %}
    if (graph->{{ 'inputs' if name == 'input' else 'outputs' }}()->Get(0) != {{ tensor.tensor_index }} ||
        !{{ name }} || {{ name }}->type != kTfLiteInt8 || {{ name }}->bytes != {{ tensor.size }} ||
        {{ name }}->dims->size != {{ tensor.shape | length }} ||
        {{ name }}->params.scale != {{ tensor.scale.hex() }}f ||
        {{ name }}->params.zero_point != {{ tensor.zero_point }}) return {{ fixture_status.io_contract }};
{% for dim in tensor.shape %}
    if ({{ name }}->dims->data[{{ loop.index0 }}] != {{ dim }}) return {{ fixture_status.io_contract }};
{% endfor %}
{% endfor %}
    auto *input_data = input->data.int8;
    auto *output_data = reinterpret_cast<const uint8_t *>(output->data.int8);
    auto invoke = [&]() { return interpreter.Invoke(); };
    hpx_fixture_memory_snapshot(3, interpreter.arena_used_bytes());
{% endif %}
    if (!hpx_stimer_init()) return {{ fixture_status.stimer }};
    for (unsigned i = 0; i < {{ fixture_warmups }}; ++i) {
        std::memcpy(input_data, fixed_input, sizeof(fixed_input));
        if (invoke() != 0) return {{ fixture_status.invoke }};
    }
{% if not fixture_aot %}
    hpx_fixture_memory_snapshot(4, interpreter.arena_used_bytes());
{% endif %}
    int32_t invocation_status = 0;
    uint32_t ticks = 0;
{% if fixture_timing_scope == 'restore_and_invoke' %}
    const uint32_t t0 = hpx_stimer_ticks();
{% endif %}
    for (unsigned i = 0; i < {{ fixture_iterations }}; ++i) {
        std::memcpy(input_data, fixed_input, sizeof(fixed_input));
{% if fixture_timing_scope == 'invoke_only' %}
        const uint32_t t0 = hpx_stimer_ticks();
{% endif %}
        invocation_status |= invoke();
{% if fixture_timing_scope == 'invoke_only' %}
        ticks += hpx_stimer_ticks() - t0;
{% endif %}
    }
{% if fixture_timing_scope == 'restore_and_invoke' %}
    ticks = hpx_stimer_ticks() - t0;
{% endif %}
    if (invocation_status != 0) return {{ fixture_status.invoke }};
    if (!ticks || ticks >= 60U*HPX_STIMER_HZ) return {{ fixture_status.timing_bound }};
{% if not fixture_aot %}
    hpx_fixture_memory_snapshot(5, interpreter.arena_used_bytes());
    hpx_fixture_memory_finish();
{% endif %}
    deployment_timing[0] = ticks;
    deployment_timing[1] = {{ fixture_iterations }};
    deployment_timing[2] = {{ fixture_warmups }};
    deployment_timing[3] = HPX_STIMER_HZ;
    deployment_timing[4] = g_hpx_stimer_last_ticks;
    deployment_timing[5] = SystemCoreClock;
    deployment_timing[6] = {{ 1 if fixture_timing_scope == "invoke_only" else 2 }};
    for (unsigned i = 0; i < sizeof(deployment_output); ++i) {
        deployment_output[i] = output_data[i];
    }
    return 0;
}

int main() {
{% with power_only=true, perf_mode_symbol="NSX_PERF_LOW", perf_mode_mhz=96 %}{% include "_system_config.j2" %}{% endwith %}
    int32_t status = nsx_system_init(&sys_cfg);
    if (status == 0) {
        SystemCoreClock = 96000000U;
        am_hal_pwrctrl_sram_memcfg_t sram = {};
        sram.eSRAMCfg = AM_HAL_PWRCTRL_SRAM_3M;
        sram.eActiveWithMCU = AM_HAL_PWRCTRL_SRAM_3M;
        sram.eActiveWithGFX = AM_HAL_PWRCTRL_SRAM_NONE;
        sram.eActiveWithDISP = AM_HAL_PWRCTRL_SRAM_NONE;
        sram.eSRAMRetain = AM_HAL_PWRCTRL_SRAM_3M;
        status = am_hal_pwrctrl_sram_config(&sram) == 0 ? infer_fixture() : {{ fixture_status.sram_config }};
        uint32_t checksum = 0;
        for (unsigned i = 0; i < sizeof(deployment_output); ++i) checksum = checksum*31U + deployment_output[i];
        deployment_checksum = checksum;
    }
    deployment_status = status;
    for (;;) __WFI();
}
