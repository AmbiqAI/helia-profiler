{# Measure the core clock against STIMER.
   Boot cost, outside measured regions: hpx_stimer_init() (two 10 ms settle
   probes warm, up to its 1 s deadline cold) plus three ~17 ms passes. #}
    if (hpx_stimer_init() != 0U) {
        // Probe attach can freeze DWT; take max.
        dwt_init();
        const uint32_t clock_probe_ticks = 546U;  // ~17 ms of STIMER
        // Caps a stalled STIMER; 0 Hz flags it.
        const uint32_t clock_probe_max_reads = 1U << 25;
        uint32_t clock_probe_reads = 0U;
        uint32_t clock_probe_cyc = 0U;
        for (int clock_probe_pass = 0; clock_probe_pass < 3; clock_probe_pass++) {
            // Start on a tick edge.
            const uint32_t clock_probe_s0 = hpx_stimer_ticks();
            uint32_t clock_probe_s1 = clock_probe_s0;
            while (clock_probe_s1 == clock_probe_s0 && ++clock_probe_reads < clock_probe_max_reads) {
                clock_probe_s1 = hpx_stimer_ticks();
            }
            const uint32_t clock_probe_c0 = DWT->CYCCNT;
            while ((uint32_t)(hpx_stimer_ticks() - clock_probe_s1) < clock_probe_ticks &&
                   ++clock_probe_reads < clock_probe_max_reads) {
            }
            const uint32_t clock_probe_pass_cyc = (uint32_t)(DWT->CYCCNT - clock_probe_c0);
            if (clock_probe_pass_cyc > clock_probe_cyc) {
                clock_probe_cyc = clock_probe_pass_cyc;
            }
        }
        const uint64_t clock_probe_hz =
            clock_probe_reads >= clock_probe_max_reads
                ? 0ULL
                : ((uint64_t)clock_probe_cyc * (uint64_t)HPX_STIMER_HZ) / (uint64_t)clock_probe_ticks;
        hpx_printf("HPX_MEASURED_CLOCK_HZ=%lu\n", (unsigned long)clock_probe_hz);
    }
