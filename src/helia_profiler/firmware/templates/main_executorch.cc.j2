{% extends "_main_base.cc.j2" %}
{#- main_executorch.cc — heliaPROFILER firmware entry point for ExecuTorch.

   The firmware skeleton -- boot, transport preamble, GPIO sync, clean-window
   machinery, PMU pass loop, teardown -- lives in _main_base.cc.j2; this
   template only fills in the engine_* blocks with the nsx::executorch runtime
   API and its per-operator profiling callbacks.  Read that file's prelude for
   the whitespace contract these definitions follow: a region block opens with
   a newline and closes with `{%- endblock %}` (the base supplies the newline
   that terminates the last line), and a single-line block holds exactly one
   line with no newlines of its own.

   This conversion is a deliberate, disclosed BEHAVIOUR CHANGE (#154 phase 4,
   step 4).  Standing alone, this template had drifted away from the skeleton
   and lost features the other engines carry: the HPX_ENGINE / HPX_ITERATIONS
   / HPX_WARMUP / HPX_POWER_SYNC wire lines, the heartbeat protocol (config
   lines, phase heartbeats and in-op heartbeats -- the host's only hang
   detector), the RTT lossless/non-blocking discipline around CSV dumps and
   the final sentinel, the USB DTR settle and usb_timer pause/resume, the
   named-constant SWO sync preamble, and UART support at all.  Inheriting the
   skeleton restores all of them.  What it must NOT inherit is the clean
   window's measurement semantics (see engine_clean_window below) or the
   HPX_PROFILED_INFER_* summary (see engine_profiled_summary at the bottom):
   both would put this engine's load+execute cost on the wire under keys every
   other engine uses for execute-only inference timing.

   ExecuTorch has no dedicated power binary: stages.preflight
   _check_transport_support rejects engine.type=executorch with power.enabled
   (pinned by tests/contracts/test_executorch_power_tripwire.py), so no
   `power_only` render of this template is reachable from a supported
   configuration and none of the blocks here carry a power_only branch. #}

{% block engine_file_header %}
/**
 * @file main.cc
 * @brief heliaPROFILER firmware (ExecuTorch) — auto-generated, do not edit.
 *
 * Loads and runs an embedded ExecuTorch .pte program through the NSX
 * ExecuTorch runtime, with per-operator PMU profiling via the runtime's
 * begin/end operator callbacks.  Emits CSV results over {{ transport | upper }}
 * for the host-side capture stage to parse.
 */
{%- endblock %}

{% block engine_includes %}
// NSX ExecuTorch runtime (PTE loader + profiled runner)
#include "nsx_executorch.h"
{% if has_armv8m_pmu %}
{# nsx_pmu_utils.h is the nsx_pmu_* config/counter API the ExecuTorch operator
   callbacks drive directly, exactly as heliaAOT's operator callback does
   (heliaRT reaches the same hardware through HpxPmuProfiler instead, so the
   base's Armv8-M block carries only nsx_ambiq_pmu.h / am_mcu_apollo.h).  Gated
   the same way the AOT child gates it so the umbrella HAL header can never be
   pulled in twice or, on a part without the Armv8-M PMU, at all. #}
#include "nsx_pmu_utils.h"
{% endif %}
{%- endblock %}

{% block engine_model_storage %}
// PTE program data (xxd-style include).  ExecuTorch always embeds the
// program: there is no runtime PSRAM upload path for this engine (preflight
// rejects psram model/arena placement for it), which is also why
// engine_pre_start stays at the base's empty default.
#include "model_data.h"
{%- endblock %}

{% block engine_globals %}
// Sized from soc.pmu_max_ops rather than hardcoded -- see hpx_pmu_profiler.h.j2's
// kMaxLayers and main_aot.cc.j2's for the same per-part reasoning.
static constexpr int kMaxLayers = {{ pmu_max_ops }};
static constexpr int kMaxCounters = 4;

struct LayerRecord {
    nsx::executorch::OperatorEvent event;
    uint32_t counters[kMaxCounters];
    bool overflow;
};

static nsx_pmu_config_t g_pmu_cfg = {};
// POD (no vtable), so a NOLOAD/zero-init section is safe -- see the AOT
// template's g_layers comment.  The base powers the AP5 shared SSRAM domain
// for it via pmu_profiler_sram_resident (true for every non-power render, and
// ExecuTorch has no power render at all).
NSX_MEM_SRAM_BSS static LayerRecord g_layers[kMaxLayers];
static const char *g_counter_names[kMaxCounters] = {};
static int g_num_layers = 0;
static int g_num_counters = 0;
static uint32_t g_logical_overflow_mask = 0U;
static bool g_profile_enabled = false;
static bool g_layer_capacity_exceeded = false;

// Heartbeat state — cheap counters/timestamps updated on each operator finish
// so the host can detect a hung run without wall-clock timeouts.  Ported from
// the heliaAOT callback in step 4: standing alone this template emitted no
// in-op heartbeats at all, so a stalled ExecuTorch run looked identical to a
// slow one from the host side.
static uint32_t g_hb_every_cyc = 0;
static int      g_hb_every_ops = 0;
static uint32_t g_hb_last_cyc = 0;
static int      g_hb_ops_since = 0;
static int      g_hb_pass = 0;
static int      g_hb_iter = 0;

{#- Every runtime buffer is placed explicitly: its own engine.config
    *_location override when given, otherwise the run's arena region. -#}
{% macro exec_buffer(name, size, region) -%}
{% if region == "sram" %}NSX_MEM_SRAM_BSS {% else %}NSX_MEM_FAST_BSS {% endif %}alignas(16) static uint8_t {{ name }}[{{ size }}];
{%- endmacro %}
{{ exec_buffer("g_planned_arena", executorch_planned_arena_size, executorch_planned_arena_region) }}
{{ exec_buffer("g_method_arena", executorch_method_arena_size, executorch_method_arena_region) }}
{{ exec_buffer("g_temporary_arena", executorch_temporary_arena_size, executorch_temporary_arena_region) }}
{{ exec_buffer("g_input", executorch_input_size, executorch_io_region) }}
{{ exec_buffer("g_output", executorch_output_size, executorch_io_region) }}

static bool profiler_init(
    const uint32_t event_ids[], const char *const names[], int count) {
    nsx_pmu_reset_config(&g_pmu_cfg);
    g_pmu_cfg.api = &nsx_pmu_V1_0_0;
    g_num_counters = count > kMaxCounters ? kMaxCounters : count;
    g_logical_overflow_mask = 0U;
    for (int i = 0; i < g_num_counters; ++i) {
        nsx_pmu_event_create(
            &g_pmu_cfg.events[i], event_ids[i], NSX_PMU_EVENT_COUNTER_SIZE_32);
        g_counter_names[i] = names[i];
        // NSX implements each 32-bit event as a 16-bit event counter followed
        // by a 16-bit CHAIN counter. Overflow of the low half is the expected
        // carry; only overflow of the high half means the logical value was
        // truncated.
        g_logical_overflow_mask |= 1UL << (2 * i + 1);
    }
    const uint32_t status = nsx_pmu_init(&g_pmu_cfg);
    hpx_printf("HPX_PMU_INIT_STATUS=%lu\n", (unsigned long)status);
    if (status != NSX_STATUS_SUCCESS) return false;

    // A CPU-cycles selection must advance during a bounded busy loop. This
    // catches a powered-down/frozen PMU before producing plausible-looking
    // all-zero layer data. Sparse counters are allowed to remain zero.
    int cpu_cycles_slot = -1;
    for (int i = 0; i < g_num_counters; ++i) {
        if (event_ids[i] == 0x0011U) cpu_cycles_slot = i;
    }
    if (cpu_cycles_slot >= 0) {
        uint32_t saved_cyccnt = DWT->CYCCNT;
        nsx_pmu_reset_counters();
        DWT->CYCCNT = saved_cyccnt;
        for (volatile uint32_t i = 0; i < 256U; ++i) { __NOP(); }
        saved_cyccnt = DWT->CYCCNT;
        const uint32_t read_status = nsx_pmu_get_counters(&g_pmu_cfg);
        DWT->CYCCNT = saved_cyccnt;
        const uint32_t observed = g_pmu_cfg.counter[cpu_cycles_slot].counterValue;
        hpx_printf("HPX_PMU_SELFTEST_CPU_CYCLES=%lu\n", (unsigned long)observed);
        if (read_status != NSX_STATUS_SUCCESS || observed == 0U) return false;
    }
    return true;
}

static uint32_t begin_operator(
    void *, const nsx::executorch::OperatorEvent &event) {
    if (!g_profile_enabled) return UINT32_MAX;
    if (g_num_layers >= kMaxLayers) {
        g_layer_capacity_exceeded = true;
        return UINT32_MAX;
    }
    const uint32_t index = (uint32_t)g_num_layers++;
    g_layers[index].event = event;
    g_layers[index].overflow = false;
    const uint32_t saved_cyccnt = DWT->CYCCNT;
    nsx_pmu_reset_counters();
    DWT->CYCCNT = saved_cyccnt;
    return index;
}

static void end_operator(void *, uint32_t handle) {
    if (!g_profile_enabled || handle >= (uint32_t)g_num_layers) return;
#if (__CORTEX_M >= 55U)
    // Snapshot before nsx_pmu_get_counters(), which resets counters and clears
    // PMOVSSET as part of its read/re-arm sequence.
    const uint32_t overflow_status = ARM_PMU_Get_CNTR_OVS();
#else
    const uint32_t overflow_status = 0U;
#endif
    const uint32_t saved_cyccnt = DWT->CYCCNT;
    const uint32_t status = nsx_pmu_get_counters(&g_pmu_cfg);
    DWT->CYCCNT = saved_cyccnt;
    LayerRecord &record = g_layers[handle];
    record.overflow =
        (overflow_status & g_logical_overflow_mask) != 0U ||
        status != NSX_STATUS_SUCCESS;
    for (int i = 0; i < g_num_counters; ++i) {
        record.counters[i] = g_pmu_cfg.counter[i].counterValue;
    }

    // Heartbeat emission (inter-op gap, not contaminating a layer) — the
    // counters above are already latched, so the printf cost lands between
    // operators exactly as it does in the heliaAOT callback.
    ++g_hb_ops_since;
    const bool by_ops = (g_hb_every_ops > 0) &&
                        (g_hb_ops_since >= g_hb_every_ops);
    bool by_time = false;
    if (g_hb_every_cyc > 0) {
        uint32_t now = DWT->CYCCNT;
        uint32_t delta = now - g_hb_last_cyc;
        by_time = (delta >= g_hb_every_cyc);
    }
    if (by_ops || by_time) {
        hpx_printf("HPX_HEARTBEAT phase=infer pass=%d iter=%d layer=%d\n",
                   g_hb_pass, g_hb_iter, g_num_layers);
        g_hb_last_cyc = DWT->CYCCNT;
        g_hb_ops_since = 0;
    }
}

static const nsx::executorch::ProfilingCallbacks g_callbacks = {
    nullptr, begin_operator, end_operator};

// One parameterless run wrapper for every call site.  The base skeleton has a
// single engine_invoke seam reused by the warmup, clean-window and profiled
// loops, so whether a run is profiled is read from g_profile_enabled (armed by
// engine_pass_warmup_arm / engine_pass_profile_arm / engine_profiler_off)
// rather than passed as an argument.  The input/output memsets that used to
// live here moved out to engine_reset_inputs / engine_reset_inputs_warm:
// skeleton discipline puts input setup outside the measured region.
static nsx::executorch::RunResult run_model(void) {
    const nsx::executorch::Buffer inputs[] = { {g_input, sizeof(g_input)} };
    nsx::executorch::Buffer outputs[] = { {g_output, sizeof(g_output)} };
    return nsx::executorch::run_once_profiled(
        model_data, model_data_len,
        {g_method_arena, sizeof(g_method_arena)},
        {g_planned_arena, sizeof(g_planned_arena)},
        {g_temporary_arena, sizeof(g_temporary_arena)},
        inputs, 1, outputs, 1, g_profile_enabled ? &g_callbacks : nullptr);
}

static void require_ok(const nsx::executorch::RunResult &result) {
    if (result.ok()) return;
    hpx_printf("HPX_ERROR=executorch stage=%s error=%lu planned=%lu\n",
               nsx::executorch::stage_name(result.stage),
               (unsigned long)result.executorch_error,
               (unsigned long)result.planned_bytes_required);
    hpx_park();
}

static void print_layers(void) {
    hpx_printf("\"Layer\",\"Op\"");
    for (int i = 0; i < g_num_counters; ++i) {
        hpx_printf(",\"%s\"", g_counter_names[i]);
    }
    hpx_printf(",\"overflow\"\n");
    for (int i = 0; i < g_num_layers; ++i) {
        const LayerRecord &record = g_layers[i];
        hpx_printf("%d,%s:c%ldi%lu", i,
                   record.event.kind == nsx::executorch::OperatorKind::kKernel
                       ? "OPERATOR_CALL" : "DELEGATE_CALL",
                   (long)record.event.chain_index,
                   (unsigned long)record.event.instruction_index);
        for (int c = 0; c < g_num_counters; ++c) {
            hpx_printf(",%lu", (unsigned long)record.counters[c]);
        }
        hpx_printf(",%d\n", record.overflow ? 1 : 0);
    }
}
{%- endblock %}

