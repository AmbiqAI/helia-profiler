{% extends "_main_base.cc.j2" %}
{% set restore_clean_inputs = not busy_loop_probe %}
{% set pool_regions = [] if allocate_arenas else arena_regions | selectattr("role", "equalto", "pool") | list %}
{#- The stream pool's bytes set to 0x5A, inline in main() where the arena
   buffers are declared: a piece that lands late, or a unit never copied,
   then shows in the run's outputs. #}
{% macro poison_pool(indent) %}{% for region in pool_regions %}
{{ indent }}memset(hpx_arena_buf_{{ region.region_id }}, 0x5A, {{ region.size }}U);{% endfor %}{% endmacro %}
{#- main_aot.cc — heliaPROFILER firmware entry point for the heliaAOT engine.

   The firmware skeleton -- boot, transport preamble, PSRAM/clean-window
   machinery, GPIO sync, INA228 bracketing, PMU pass loop, teardown -- lives
   in _main_base.cc.j2; this template only fills in the engine_* blocks with
   the heliaAOT model-API code (bind_arena / model_init / model_run plus the
   per-operator callback that stands in for heliaRT's profiler hooks).  Read
   that file's prelude for the whitespace contract these definitions follow:
   a region block opens with a newline and closes with `{%- endblock %}` (the
   base supplies the newline that terminates the last line), and a
   single-line block holds exactly one line with no newlines of its own.

   Which clock times the measured window (busy_loop_probe / window_timer /
   use_stimer_window) is resolved HOST-SIDE, once, and arrives here as plain
   variables: the per-SoC half in SocCapabilities.power_window_timer, the
   per-render half in firmware/context.py resolve_window_timer() (#118).
   Read those docstrings — and _main_base.cc.j2's prelude — for the full
   dead-DWT / busy-loop-STIMER rationale (issues #106/#107/#112). #}

{% block engine_file_header %}
/**
 * @file main.cc
 * @brief heliaPROFILER firmware (heliaAOT) — auto-generated, do not edit.
 *
 * Runs AOT-compiled inference with per-layer PMU profiling via the model
 * operator callback.  Emits CSV results over {{ transport | upper }} for the host-side
 * capture stage to parse.
 */
{%- endblock %}

{% block engine_includes %}
{% if not busy_loop_probe and input_fill == "zero" %}
#define HPX_CLEAN_WORKLOAD "aot_raw_zero_refill_included_v1"
{% endif %}
// heliaAOT model API
#include "{{ aot_prefix }}_model.h"
#include "{{ aot_prefix }}_common.h"
#if __has_include("{{ aot_prefix }}_nsx_transfer.h")
// The module emitted its transfer provider for dma units: hpx binds it
// before model_init and reports its evidence per run.
#include "{{ aot_prefix }}_nsx_transfer.h"
#include "nsx_psram.h"
#define HPX_AOT_TRANSFER 1
#endif
{% if stream_evidence and pool_regions %}
#ifndef {{ aot_prefix }}_num_dma_units
#error "profiling.stream_evidence binds a stream pool, but the module does not declare {{ aot_prefix }}_num_dma_units"
#endif
{% endif %}
{% if has_armv8m_pmu %}
{# nsx_pmu_utils.h is the nsx_pmu_* config/counter API the AOT operator
   callback drives directly (heliaRT reaches the same hardware through
   HpxPmuProfiler instead, so the base's Armv8-M block carries only
   nsx_ambiq_pmu.h / am_mcu_apollo.h). #}
#include "nsx_pmu_utils.h"
{% endif %}
{% if has_ethos_u | default(false) %}
// Ethos-U NPU bring-up (nsx-npu module): powers/initializes the microNPU
// before the AOT runtime dispatches its ethos-u operator to it.
#include "nsx_npu.h"
{% endif %}
{%- endblock %}

{% block engine_early_globals %}
{% if not allocate_arenas %}{% for region in arena_regions %}{% if region.blob_filename %}
#include "hpx_const_blob_{{ region.region_id }}.h"
{%- endif %}{% endfor %}{% endif %}
{%- endblock %}

{% block engine_globals %}
// Large proxy models can compile to well over 2048 operators; keep enough
// headroom here to avoid silently truncating the capture stream. Templated
// from soc.pmu_max_ops (not hardcoded -- see hpx_pmu_profiler.h.j2's
// kMaxLayers for the analogous heliaRT constant: a fixed 4096 here is
// ~96 KB of g_layers[] alone, meaningful on 240 KB-TCM parts).
static constexpr int kMaxLayers = {{ pmu_max_ops }};
static constexpr int kMaxEvents = 4;

struct HpxLayerRecord {
    uint32_t counters[kMaxEvents];
    bool overflow;
};

{% if has_armv8m_pmu %}
static nsx_pmu_config_t g_pmu_cfg;
{% include "_pmu_read.j2" %}

// Restarts the event counters; DWT->CYCCNT, which times the run, keeps counting.
static inline void hpx_pmu_restart(void) {
    uint32_t saved_cyccnt = DWT->CYCCNT;
    nsx_pmu_reset_counters();
    DWT->CYCCNT = saved_cyccnt;
#if (__CORTEX_M >= 55U)
    ARM_PMU_Set_CNTR_OVS(0xFFFFFFFFU);
#endif
}
{% else %}
static uint32_t g_op_start_cyccnt = 0;
{% endif %}
{% if not power_only | default(false) %}
// g_layers is plain-old-data (no vtable), so unlike heliaRT's polymorphic
// HpxPmuProfiler (main.cc.j2) it's safe in a NOLOAD/zero-init section --
// no initialized image needs preserving. Moved off TCM for the same
// reason as that fix: this array alone is kMaxLayers*(4*4+1, padded to
// 20) bytes -- 80 KB at the default 4096 -- a meaningful bite out of
// AP330's 240 KB TCM budget when combined with the arena and any
// per-tensor TCM placement overrides. power_only builds never run
// per-layer profiling, so this only needs the SRAM move in the
// transport-attached binary.
//
// AP5 family requires the shared SSRAM power domain to be explicitly
// powered on for this array to be readable/writable (see
// _ssram_power.j2, driven by pmu_profiler_sram_resident before its
// include in main()) -- without it a TCM-resident-arena render leaves
// the domain off and per-layer writes land in an unbacked bank.
NSX_MEM_SRAM_BSS static HpxLayerRecord g_layers[kMaxLayers];
{% else %}
static HpxLayerRecord g_layers[kMaxLayers];
{% endif %}
static int g_num_layers = 0;
static bool g_layer_capacity_exceeded = false;
// The model_run status that ended the last loop early: a loop stops at its
// first failed run and the check after the loop reports it.
static int32_t hpx_aot_status = 0;
static int g_num_counters = 0;
static bool g_profiler_enabled = false;
static const char* g_counter_names[kMaxEvents] = {};
{% if not power_only | default(false) %}

#ifdef HPX_AOT_TRANSFER
// Per instrumented run, beside the layer records: for each transfer unit's
// issue and each operator's run, whether the MSPI controller's DMA was in
// progress (bit 0) and nsx-psram had reads pending (bit 1) at both ends; the
// L1D refills over each unit's issue window; and a latch for the provider's
// power clause.
static uint8_t g_transfer_unit_overlap[{{ aot_prefix }}_num_transfer_units];
NSX_MEM_SRAM_BSS static uint8_t g_transfer_op_overlap[kMaxLayers];
{% if has_armv8m_pmu %}
static uint32_t g_transfer_unit_refills[{{ aot_prefix }}_num_transfer_units];
static int g_transfer_refill_slot = -1;
{% endif %}
static bool g_transfer_power_clause = false;
static uint32_t g_transfer_sample_failures = 0;
static {{ aot_prefix }}_nsx_transfer_stats_t g_transfer_stats_before;

// One sample: bit 0 when the DMA-in-progress bit read set, bit 1 when
// nsx-psram had reads pending, bit 2 when the bit could not be read, which is
// no evidence either way.
static uint8_t hpx_transfer_sample(void) {
    bool dma = false;
    const bool sampled = nsx_psram_dma_in_progress(&dma) == 0U;
    if (!sampled) {
        ++g_transfer_sample_failures;
    }
    return (uint8_t)((sampled ? (dma ? 1U : 0U) : 4U) | ((nsx_psram_pending() > 0U) ? 2U : 0U));
}

// Both ends: a flag holds only when set at both, and an end not sampled
// leaves the DMA flag unknown.
static inline uint8_t hpx_transfer_ends(uint8_t first, uint8_t last) {
    return (uint8_t)((first & last & 3U) | ((first | last) & 4U));
}
#endif
{% endif %}

// Heartbeat state — cheap counters/timestamps updated on each op finish so
// the host can detect a hung run without wall-clock timeouts.
static uint32_t g_hb_every_cyc = 0;
static int      g_hb_every_ops = 0;
static uint32_t g_hb_last_cyc = 0;
static int      g_hb_ops_since = 0;
static int      g_hb_pass = 0;
static int      g_hb_iter = 0;

// AOT operator name table — extracted from the AIR graph by heliaPROFILER.
// Maps sequential execution index → operator type string.
// heliaAOT may fuse/remove ops, so this reflects the *actual* compiled graph.
{% if aot_op_manifest %}
static constexpr int kNumAotOps = {{ aot_op_manifest | length }};
struct AotOpInfo {
    int32_t id;           // .tflite operator index; -1 when it has none or several
    const char *op_type;  // e.g. "CONV_2D", "FULLY_CONNECTED"
};
static const AotOpInfo kAotOps[kNumAotOps] = {
{% for op in aot_op_manifest %}
    { {{ op.id }}, "{{ op.op_type | upper }}" },
{% endfor %}
};

static const char *aot_op_name(int layer_idx) {
    if (layer_idx >= 0 && layer_idx < kNumAotOps) return kAotOps[layer_idx].op_type;
    return "unknown";
}

static int32_t aot_op_id(int layer_idx) {
    if (layer_idx >= 0 && layer_idx < kNumAotOps) return kAotOps[layer_idx].id;
    return layer_idx;
}
{% else %}
// No operator manifest available — fall back to index-based names.
static const char *aot_op_name(int /*layer_idx*/) { return "op"; }
static int32_t aot_op_id(int layer_idx) { return layer_idx; }
{% endif %}

{% if has_armv8m_pmu %}
static void profiler_set_counter_names(const char* const names[], int num_names) {
    int limit = (num_names > kMaxEvents) ? kMaxEvents : num_names;
    if (limit < 0) {
        limit = 0;
    }
    for (int i = 0; i < limit; i++) {
        g_counter_names[i] = names[i];
    }
    for (int i = limit; i < kMaxEvents; i++) {
        g_counter_names[i] = nullptr;
    }
}

static void profiler_init_custom(const uint32_t event_ids[], int num_events) {
    nsx_pmu_reset_config(&g_pmu_cfg);
    g_pmu_cfg.api = &nsx_pmu_V1_0_0;
    int n = (num_events > kMaxEvents) ? kMaxEvents : num_events;
    for (int i = 0; i < n; i++) {
        nsx_pmu_event_create(&g_pmu_cfg.events[i], event_ids[i],
                            NSX_PMU_EVENT_COUNTER_SIZE_32);
    }
    nsx_pmu_init(&g_pmu_cfg);
    g_num_counters = n;
}
{% else %}
static void profiler_init_custom(const uint32_t[], int) {
    g_num_counters = 1;
}
{% endif %}

static void profiler_clear(void) {
    g_num_layers = 0;
    g_layer_capacity_exceeded = false;
}

static void profiler_print_csv(void) {
    if (g_num_layers == 0) return;
    hpx_printf("\"Layer\",\"Op\"");
{% if has_armv8m_pmu %}
    for (int e = 0; e < g_num_counters; e++) {
        if (!g_pmu_cfg.events[e].enabled) break;
        if (g_counter_names[e] != nullptr)
            hpx_printf(",\"%s\"", g_counter_names[e]);
        else
            hpx_printf(",\"0x%04lx\"", (unsigned long)g_pmu_cfg.events[e].eventId);
    }
{% else %}
    hpx_printf(",\"ARM_PMU_CPU_CYCLES\"");
{% endif %}
    hpx_printf(",\"overflow\"\n");
    for (int i = 0; i < g_num_layers; i++) {
        const auto &rec = g_layers[i];
        // Print: Layer index, Op type with AOT operator ID for uniqueness.
        // Format: "CONV_2D:3" — type:id, so the host can disambiguate
        // multiple operators of the same type.
        hpx_printf("%d,%s:%ld", i, aot_op_name(i), (long)aot_op_id(i));
        for (int e = 0; e < g_num_counters; e++) {
    {% if has_armv8m_pmu %}
            if (!g_pmu_cfg.events[e].enabled) break;
    {% endif %}
            hpx_printf(",%lu", (unsigned long)rec.counters[e]);
        }
        hpx_printf(",%d\n", rec.overflow ? 1 : 0);
    }
}

// AOT operator callback — PMU start/stop per operator.  This is heliaAOT's
// equivalent of heliaRT's per-op profiler hooks.
static void model_operator_cb(
    int32_t op,
    {{ aot_prefix }}_operator_state_t state,
    int32_t status,
    void *user_data
) {
    (void)op;
    (void)status;
    (void)user_data;

    if (!g_profiler_enabled) return;
{% if not power_only | default(false) %}

#ifdef HPX_AOT_TRANSFER
    // Transfer states arrive outside every operator's run window; for them
    // op is the unit id.
    if (state == {{ aot_prefix }}_op_state_transfer_wait_started) {
        // A dma unit's pieces are in flight until this wait: deep sleep must
        // be refused.
        if ({{ aot_prefix }}_nsx_transfer_can_sleep()) {
            g_transfer_power_clause = true;
        }
        return;
    }
    if (state == {{ aot_prefix }}_op_state_transfer_issue_started ||
        state == {{ aot_prefix }}_op_state_transfer_issue_finished) {
        if (op < 0 || op >= {{ aot_prefix }}_num_transfer_units) {
            return;
        }
        if (state == {{ aot_prefix }}_op_state_transfer_issue_started) {
            g_transfer_unit_overlap[op] = hpx_transfer_sample();
{% if has_armv8m_pmu %}
            if (g_transfer_refill_slot >= 0) {
                hpx_pmu_restart();
            }
{% endif %}
        } else {
{% if has_armv8m_pmu %}
            if (g_transfer_refill_slot >= 0) {
                (void)hpx_pmu_read_layer(&g_pmu_cfg, g_num_counters);
                g_transfer_unit_refills[op] = g_pmu_cfg.counter[g_transfer_refill_slot].counterValue;
            }
{% endif %}
            g_transfer_unit_overlap[op] = hpx_transfer_ends(g_transfer_unit_overlap[op], hpx_transfer_sample());
        }
        return;
    }
    if (state == {{ aot_prefix }}_op_state_run_started && g_num_layers < kMaxLayers) {
        g_transfer_op_overlap[g_num_layers] = hpx_transfer_sample();
    }
#endif
{% endif %}

    if (state == {{ aot_prefix }}_op_state_run_started) {
{% if has_armv8m_pmu %}
        // Reset PMU counters at the start of each operator
        hpx_pmu_restart();
{% else %}
    g_op_start_cyccnt = DWT->CYCCNT;
{% endif %}
    } else if (state == {{ aot_prefix }}_op_state_run_finished) {
        // Read PMU counters after each operator completes
        if (g_num_layers >= kMaxLayers) {
            g_layer_capacity_exceeded = true;
            return;
        }
        int idx = g_num_layers++;
{% if has_armv8m_pmu %}
        g_layers[idx].overflow = hpx_pmu_read_layer(&g_pmu_cfg, g_num_counters);
        for (int i = 0; i < g_num_counters; i++) {
            g_layers[idx].counters[i] = g_pmu_cfg.counter[i].counterValue;
        }
    {% else %}
        g_layers[idx].counters[0] = DWT->CYCCNT - g_op_start_cyccnt;
        g_layers[idx].overflow = false;
    {% endif %}
{% if not power_only | default(false) %}
#ifdef HPX_AOT_TRANSFER
        g_transfer_op_overlap[idx] = hpx_transfer_ends(g_transfer_op_overlap[idx], hpx_transfer_sample());
#endif
{% endif %}
        // Heartbeat emission (inter-op gap, not contaminating a layer)
        ++g_hb_ops_since;
        const bool by_ops = (g_hb_every_ops > 0) &&
                            (g_hb_ops_since >= g_hb_every_ops);
        bool by_time = false;
        if (g_hb_every_cyc > 0) {
            uint32_t now = DWT->CYCCNT;
            uint32_t delta = now - g_hb_last_cyc;
            by_time = (delta >= g_hb_every_cyc);
        }
        if (by_ops || by_time) {
            hpx_printf("HPX_HEARTBEAT phase=infer pass=%d iter=%d layer=%d\n",
                       g_hb_pass, g_hb_iter, g_num_layers);
            g_hb_last_cyc = DWT->CYCCNT;
            g_hb_ops_since = 0;
        }
    }
}

// AOT model context with profiling callback
// ---------------------------------------------------------------------------
{% if has_ethos_u | default(false) and not power_only | default(false) %}
// Engine seams for the engine-agnostic _npu_pmu.j2 (see its header). The
// driver hooks fire inside an operator's run window, i.e. after the
// callback's run_started (g_num_layers not yet incremented) and before
// run_finished assigns this record index — so the executing layer's ordinal
// is exactly g_num_layers.
#define HPX_NPU_MAX_LAYERS kMaxLayers
static inline int hpx_npu_current_layer(void) { return g_num_layers; }
static inline int hpx_npu_num_layers(void) { return g_num_layers; }
static inline void hpx_npu_print_row_head(int i) {
    // Same "TYPE:id" tag as profiler_print_csv() so the host merges this
    // preset with ARM-PMU presets by layer index and tag.
    hpx_printf("%d,%s:%ld", i, aot_op_name(i), (long)aot_op_id(i));
}
{% include "_npu_pmu.j2" %}
{% endif %}

static {{ aot_prefix }}_model_context_t {{ aot_prefix }}_model_ctx = {
    .callback = model_operator_cb,
    .user_data = nullptr
};

{% if input_fill == "lcg" %}
// profiling.input_fill: lcg. Every run's inputs are the same fixed-seed
// 32-bit LCG bytes, so an output depends on every weight, not on biases alone.
static void hpx_fill_lcg(void *data, size_t size, uint32_t seed) {
    uint8_t *bytes = (uint8_t *)data;
    uint32_t state = seed;
    for (size_t i = 0; i < size; i++) {
        state = state * 1664525U + 1013904223U;
        bytes[i] = (uint8_t)(state >> 24);
    }
}

{% endif %}
{% if not power_only | default(false) %}
// FNV-1a 64: runs are compared byte for byte by the digests of their bytes.
static uint64_t hpx_fnv1a64(const void *data, size_t size) {
    const uint8_t *bytes = (const uint8_t *)data;
    uint64_t hash = 0xcbf29ce484222325ULL;
    for (size_t i = 0; i < size; i++) {
        hash = (hash ^ bytes[i]) * 0x100000001b3ULL;
    }
    return hash;
}

static void hpx_print_output_digests(void) {
    for (int i = 0; i < {{ aot_prefix }}_num_outputs; i++) {
        hpx_printf("HPX_OUTPUT_%d_FNV1A64=%016llx\n", i,
                   (unsigned long long)hpx_fnv1a64({{ aot_prefix }}_model_ctx.outputs[i].data,
                                                   (size_t){{ aot_prefix }}_model_ctx.outputs[i].size));
    }
}

{% endif %}
#ifdef HPX_AOT_TRANSFER
// A refused bind leaves ctx.transfer as it was (unset at boot, so model_init
// would return 300); the provider's code says why.
static void hpx_transfer_bind_failed(int32_t status) {
{% if power_only | default(false) %}
    (void)status;
    hpx_power_terminal_fail("transfer_bind", 8U);
{% else %}
    hpx_printf("HPX_ERROR=transfer_bind_failed:%ld\n", (long)status);
    hpx_park();
{% endif %}
}

static void hpx_transfer_bind(const {{ aot_prefix }}_nsx_transfer_options_t *options) {
    const int32_t status = {{ aot_prefix }}_nsx_transfer_bind(&{{ aot_prefix }}_model_ctx, options);
    if (status != 0) {
        hpx_transfer_bind_failed(status);
    }
}
{% if not power_only | default(false) %}

// Before each instrumented run: clears the run's evidence and notes the
// provider's counters, which the report after the run turns into deltas.
static void hpx_transfer_run_start(void) {
    memset(g_transfer_unit_overlap, 0, sizeof(g_transfer_unit_overlap));
    memset(g_transfer_op_overlap, 0, sizeof(g_transfer_op_overlap));
    g_transfer_sample_failures = 0;
{% if has_armv8m_pmu %}
    memset(g_transfer_unit_refills, 0, sizeof(g_transfer_unit_refills));
    g_transfer_refill_slot = -1;
    for (int i = 0; i < g_num_counters; i++) {
        if (g_pmu_cfg.events[i].enabled && g_pmu_cfg.events[i].eventId == ARM_PMU_L1D_CACHE_REFILL) {
            g_transfer_refill_slot = i;
        }
    }
{% endif %}
    g_transfer_stats_before = *{{ aot_prefix }}_nsx_transfer_stats();
}

// The run has just returned, before anything is printed: the predicate must
// allow sleep again.
static void hpx_transfer_after_run(void) {
    if (!{{ aot_prefix }}_nsx_transfer_can_sleep()) {
        g_transfer_power_clause = true;
    }
}

// After each instrumented run's CSV, its evidence. Refills are printed only in a pass
// that counts L1D refills: per unit over its issue window, per operator over
// its run window (that operator's layer record). Overlap entries are
// <id>:<DMA in progress at both ends: 1, 0, or x when an end was not
// sampled>/<reads pending at both ends>. Stats are the run's issues, waits
// and aborts, the provider's peak pieces in flight and most checks a wait used
// since it was bound, and the run's unsampled DMA-in-progress reads.
static void hpx_transfer_print_ends(const char *separator, int id, uint8_t ends) {
    hpx_printf("%s%d:%c/%u", separator, id, (ends & 4U) ? 'x' : (char)('0' + (ends & 1U)),
               (unsigned)((ends >> 1) & 1U));
}

static void hpx_transfer_report(void) {
{% if has_armv8m_pmu %}
    if (g_transfer_refill_slot >= 0) {
        hpx_printf("HPX_TRANSFER_REFILLS=");
        for (int u = 0; u < {{ aot_prefix }}_num_transfer_units; u++) {
            hpx_printf("%s%d:%lu", u ? "," : "", u, (unsigned long)g_transfer_unit_refills[u]);
        }
        hpx_printf(";");
        for (int i = 0; i < g_num_layers; i++) {
            hpx_printf("%s%d:%lu", i ? "," : "", i,
                       (unsigned long)g_layers[i].counters[g_transfer_refill_slot]);
        }
        hpx_printf("\n");
    }
{% endif %}
    hpx_printf("HPX_TRANSFER_OVERLAP=");
    for (int u = 0; u < {{ aot_prefix }}_num_transfer_units; u++) {
        hpx_transfer_print_ends(u ? "," : "", u, g_transfer_unit_overlap[u]);
    }
    hpx_printf(";");
    for (int i = 0; i < g_num_layers; i++) {
        hpx_transfer_print_ends(i ? "," : "", i, g_transfer_op_overlap[i]);
    }
    hpx_printf("\n");
    const {{ aot_prefix }}_nsx_transfer_stats_t *after = {{ aot_prefix }}_nsx_transfer_stats();
    hpx_printf("HPX_TRANSFER_STATS=%lu,%lu,%lu,%lu,%lu,%lu\n",
               (unsigned long)(after->issues - g_transfer_stats_before.issues),
               (unsigned long)(after->waits - g_transfer_stats_before.waits),
               (unsigned long)(after->aborts - g_transfer_stats_before.aborts),
               (unsigned long)after->peak_in_flight, (unsigned long)after->wait_checks_max,
               (unsigned long)g_transfer_sample_failures);
}
{% endif %}
#endif

{% if transfer_timeout_probe and not power_only | default(false) %}
#ifdef HPX_AOT_TRANSFER
static void hpx_transfer_print_recovery(int32_t bind, int32_t init, int32_t run, uint32_t pending) {
    hpx_printf("HPX_TRANSFER_RECOVERY=%ld,%ld,%ld,%lu\n", (long)bind, (long)init, (long)run,
               (unsigned long)pending);
}
#endif
{% endif %}
// Run after every loop of model_run calls, outside timing: a failed run stops
// the capture instead of reporting the timing of whatever it left behind.{% if power_only | default(false) %}
static void hpx_aot_check_runs(void) {
    if (hpx_aot_status != 0) {
        hpx_power_terminal_fail("model_run", 9U);
    }
}
{% else %} With
// a provider, a broken power clause stops it the same way.
static void hpx_aot_check_runs(void) {
#ifdef HPX_AOT_TRANSFER
    if (hpx_aot_status == 0 && !g_transfer_power_clause) {
        return;
    }
#else
    if (hpx_aot_status == 0) {
        return;
    }
#endif
{% if transport == "rtt" %}
    hpx_rtt_set_blocking();
{% endif %}
#ifdef HPX_AOT_TRANSFER
    if (hpx_aot_status == 0) {
        hpx_printf("HPX_ERROR=transfer_power_clause\n");
    } else {
        const {{ aot_prefix }}_nsx_transfer_last_t *last = {{ aot_prefix }}_nsx_transfer_last();
        hpx_printf("HPX_ERROR=model_run_failed:%ld,provider=%ld,driver=%lu,ticket=%lu\n",
                   (long)hpx_aot_status, (long)last->error, (unsigned long)last->driver_status,
                   (unsigned long)last->ticket);
    }
#else
    hpx_printf("HPX_ERROR=model_run_failed:%ld\n", (long)hpx_aot_status);
#endif
    hpx_park();
}
{% endif %}
{%- endblock %}

{# The base emits HPX_MODEL_SIZE / HPX_ARENA_SIZE only for engines that own a
   model blob and a single arena; heliaAOT compiles the weights in and reports
   its arenas through HPX_ARENAS_BOUND instead, so both start-metadata anchors
   stay empty here. #}
{% block engine_start_metadata %}{% endblock %}

{# PSRAM bring-up is not a pre-start step for heliaAOT: the arena regions that
   may live in PSRAM are bound in engine_model_setup, so _psram_metadata.j2 is
   emitted from inside that block instead of from the base's start header. #}
{% block engine_psram_metadata %}{% endblock %}

{% block engine_heartbeat_arm %}
    // --- Heartbeat config (matches TFLM template for protocol consistency) --
    static constexpr bool     kHbEnabled   = {{ heartbeat_enabled | lower }};
    static constexpr int      kHbEveryNOps = {{ heartbeat_every_n_ops }};
    static constexpr uint32_t kHbEveryMs   = {{ heartbeat_every_ms }};
    hpx_printf("HPX_HEARTBEAT_ENABLED=%d\n", (int)kHbEnabled);
    hpx_printf("HPX_HEARTBEAT_EVERY_N_OPS=%d\n", kHbEveryNOps);
    hpx_printf("HPX_HEARTBEAT_EVERY_MS=%lu\n", (unsigned long)kHbEveryMs);
    g_hb_every_cyc = (kHbEnabled && kHbEveryMs > 0)
        ? (uint32_t)((uint64_t)SystemCoreClock / 1000U * kHbEveryMs)
        : 0U;
    g_hb_every_ops = kHbEnabled ? kHbEveryNOps : 0;

    hpx_printf("HPX_HEARTBEAT phase=init\n");
{%- endblock %}

{% block engine_model_setup %}
{% if has_ethos_u | default(false) %}
{% include "_npu_init.j2" %}
{% endif %}
{% if not allocate_arenas and arena_regions %}
    // External arena mode: allocate and bind arena buffers before model_init.
    //
    // Each region has a "placement" (tcm | sram | psram | <default>) that
    // controls where its backing storage lives. PSRAM-placed regions are
    // assigned at runtime from the PSRAM base pointer (PSRAM is external
    // MSPI XIP and is not in the linker MEMORY map, so static .psram_bss
    // sections are not available).
{% set psram_arena_regions = arena_regions | selectattr("placement", "equalto", "psram") | list %}
{% for region in arena_regions %}
{% if region.placement == "psram" %}
    static uint8_t *hpx_arena_buf_{{ region.region_id }} = nullptr;
{% if region.blob_filename %}
    // Retained only for the blob write-back below — a blob-less PSRAM
    // region tripped -Wunused-but-set-variable (#187 gate).
    static uint32_t hpx_arena_psram_offset_{{ region.region_id }} = 0;
{% endif %}
{% elif region.placement == "tcm" %}
    NSX_MEM_FAST_BSS alignas({{ region.alignment }}) static uint8_t hpx_arena_buf_storage_{{ region.region_id }}[{{ region.size }}];
    static uint8_t *hpx_arena_buf_{{ region.region_id }} = hpx_arena_buf_storage_{{ region.region_id }};
{% elif region.placement == "sram" %}
    NSX_MEM_SRAM_BSS alignas({{ region.alignment }}) static uint8_t hpx_arena_buf_storage_{{ region.region_id }}[{{ region.size }}];
    static uint8_t *hpx_arena_buf_{{ region.region_id }} = hpx_arena_buf_storage_{{ region.region_id }};
{% else %}
    alignas({{ region.alignment }}) static uint8_t hpx_arena_buf_storage_{{ region.region_id }}[{{ region.size }}];
    static uint8_t *hpx_arena_buf_{{ region.region_id }} = hpx_arena_buf_storage_{{ region.region_id }};
{% endif %}
{% endfor %}
{% if psram_arena_regions %}
    // PSRAM init for arena regions placed in PSRAM.
    HPX_CLEAN_DCACHE();
    {
        nsx_psram_config_t psram_cfg;
        nsx_psram_default_config(&psram_cfg);
        psram_cfg.clock_hz = {{ psram_clock_hz }}U;
        psram_cfg.enable_xip = true;
        if (nsx_psram_init(&psram_cfg) != 0) {
            hpx_printf("HPX_ERROR=psram_init_failed\n");
{% if power_only | default(false) %}            hpx_power_terminal_fail("psram_init", 1U);
{% else %}
            hpx_park();
{% endif %}
        }
        nsx_psram_info_t psram_info;
        if (nsx_psram_get_info(&psram_info) != 0) {
            hpx_printf("HPX_ERROR=psram_info_failed\n");
{% if power_only | default(false) %}            hpx_power_terminal_fail("psram_info", 2U);
{% else %}
            hpx_park();
{% endif %}
        }
{% include "_psram_metadata.j2" %}
        // Stack PSRAM-placed arenas at their alignment and on 32-byte D-cache
        // lines, so cache maintenance of one arena's range never touches
        // another's bytes.
        uint32_t psram_off = 0;
{% for region in psram_arena_regions %}{% set line_aligned = [region.alignment, 32] | max %}
        psram_off = (psram_off + {{ line_aligned }} - 1u) & ~({{ line_aligned }}u - 1u);
{% if region.blob_filename %}
        hpx_arena_psram_offset_{{ region.region_id }} = psram_off;
{% endif %}
        hpx_arena_buf_{{ region.region_id }} =
            (uint8_t *)(psram_info.base_address + psram_off);
        hpx_printf("HPX_PSRAM_ARENA_REGION=%d,0x%08lx,%u\n",
                   {{ region.region_id }},
                   (unsigned long)hpx_arena_buf_{{ region.region_id }},
                   (unsigned)({{ region.size }}));
        psram_off += (uint32_t){{ region.size | word_padded }};
{% endfor %}
        HPX_CLEAN_DCACHE();
    }
{% endif %}
    {
        int32_t bind_status;
{% for region in arena_regions %}
        bind_status = {{ aot_prefix }}_bind_arena(
            ({{ aot_prefix }}_arena_region_t){{ region.region_id }},
            hpx_arena_buf_{{ region.region_id }},
            (size_t){{ region.size }}
        );
        if (bind_status != 0) {
            hpx_printf("HPX_ERROR=bind_arena_failed:%d:region=%d\n",
                       (int)bind_status, {{ region.region_id }});
{% if power_only | default(false) %}            hpx_power_terminal_fail("bind_arena", 5U);
{% else %}            hpx_park();
{% endif %}
        }
{% endfor %}
    }
    hpx_printf("HPX_ARENAS_BOUND=%d\n", {{ arena_regions | length }});

    // Load constant arena sidecar blobs into bound arena buffers.
    // The AOT compiler emits constant data (weights/biases) as binary
    // sidecar files — the profiler app embeds them into flash and
    // copies them into the arena buffers before model_init.
{% for region in arena_regions %}
{% if region.blob_filename %}
{% if region.placement == "psram" %}
    if (nsx_psram_write(
            hpx_arena_psram_offset_{{ region.region_id }},
            hpx_const_blob_{{ region.region_id }},
            sizeof(hpx_const_blob_{{ region.region_id }})) != 0) {
        hpx_printf("HPX_ERROR=const_blob_psram_write_failed:region=%d\n",
                   {{ region.region_id }});
{% if power_only | default(false) %}        hpx_power_terminal_fail("const_blob", 7U);
{% else %}        hpx_park();
{% endif %}
    }
{% else %}
    memcpy(hpx_arena_buf_{{ region.region_id }},
           hpx_const_blob_{{ region.region_id }},
           hpx_const_blob_{{ region.region_id }}_len);
{% endif %}
    hpx_printf("HPX_CONST_BLOB_LOADED region=%d size=%u\n",
               {{ region.region_id }},
               (unsigned)hpx_const_blob_{{ region.region_id }}_len);
{% endif %}
{% endfor %}
{% if psram_arena_regions | selectattr("blob_filename") | list %}
    // The constants reached PSRAM by DMA, which leaves any XIP copy of their
    // range in the D-cache stale: clean and invalidate it before the first run.
    HPX_CACHE_SYNC_SHARED_DATA();
{% endif %}
{% endif %}
#ifdef HPX_AOT_TRANSFER
    hpx_transfer_bind(nullptr);
#endif

    // Initialize AOT model
    int32_t aot_status = {{ aot_prefix }}_model_init(&{{ aot_prefix }}_model_ctx);
    if (aot_status != 0) {
        hpx_printf("HPX_ERROR=model_init_failed:%ld\n", (long)aot_status);
    {% if power_only | default(false) %}        hpx_power_terminal_fail("model_init", 6U);
    {% else %}        hpx_park();
    {% endif %}
    }
    hpx_printf("HPX_HEARTBEAT phase=model_init_done\n");

    // Report model metadata
    hpx_printf("HPX_NUM_INPUTS=%d\n", {{ aot_prefix }}_num_inputs);
    hpx_printf("HPX_NUM_OUTPUTS=%d\n", {{ aot_prefix }}_num_outputs);
{%- endblock %}

{% block engine_io_metadata %}
    for (int i = 0; i < {{ aot_prefix }}_num_inputs; i++) {
        hpx_printf("HPX_INPUT_%d_SIZE=%d\n", i,
                  (int){{ aot_prefix }}_model_ctx.inputs[i].size);
    }
    for (int i = 0; i < {{ aot_prefix }}_num_outputs; i++) {
        hpx_printf("HPX_OUTPUT_%d_SIZE=%d\n", i,
                  (int){{ aot_prefix }}_model_ctx.outputs[i].size);
    }
    hpx_printf("HPX_INPUT_FILL={{ input_fill }}\n");{% if stream_evidence %}
    hpx_printf("HPX_STREAM_EVIDENCE=1\n");{% endif %}
{%- endblock %}

{% block engine_profiler_off %}        g_profiler_enabled = false;{% endblock %}

{# The two reset-inputs blocks are multi-line but carry NO leading or trailing
   newline of their own: the base reuses each at several sites by calling it
   back through self, which supplies the surrounding newlines, so the first
   line has to glue to the block tag rather than start on the next one. #}
{% block engine_reset_inputs_warm %}            for (int i = 0; i < {{ aot_prefix }}_num_inputs; i++) {
{% if input_fill == "lcg" %}                hpx_fill_lcg({{ aot_prefix }}_model_ctx.inputs[i].data,
                             (size_t){{ aot_prefix }}_model_ctx.inputs[i].size, 0x48505831U + (uint32_t)i);
{% else %}                memset({{ aot_prefix }}_model_ctx.inputs[i].data, 0,
                       {{ aot_prefix }}_model_ctx.inputs[i].size);
{% endif %}            }{% endblock %}

{% block engine_reset_inputs %}        for (int i = 0; i < {{ aot_prefix }}_num_inputs; i++) {
{% if input_fill == "lcg" %}            hpx_fill_lcg({{ aot_prefix }}_model_ctx.inputs[i].data,
                         (size_t){{ aot_prefix }}_model_ctx.inputs[i].size, 0x48505831U + (uint32_t)i);
{% else %}            memset({{ aot_prefix }}_model_ctx.inputs[i].data, 0,
                   {{ aot_prefix }}_model_ctx.inputs[i].size);
{% endif %}        }{% endblock %}

{% block engine_invoke %}{ int32_t s = {{ aot_prefix }}_model_run(&{{ aot_prefix }}_model_ctx); if (s != 0) { hpx_aot_status = s; break; } }{% endblock %}

{% block engine_runs_check %}
hpx_aot_check_runs();{% endblock %}

{% block engine_window_prologue %}
        // model_operator_cb() is a no-op during this window (guarded by
        // g_profiler_enabled), but the AOT runtime still dispatches it via
        // an indirect call for every operator start/finish
        // ({{ aot_prefix }}_model.c already null-checks ctx->callback before
        // calling it) -- AutoDeploy's power binary has no callback at all.
        // Drop to nullptr for the measured window; restored right after.
        {{ aot_prefix }}_model_ctx.callback = nullptr;
{%- endblock %}

{% block engine_window_restore %}        // Restore the per-op callback for the instrumented per-layer passes below.
        {{ aot_prefix }}_model_ctx.callback = model_operator_cb;
{% endblock %}

{# heliaAOT re-arms the profiler per pass (engine_pass_profile_arm), so there
   is nothing to re-enable at the end of the clean window. #}
{% block engine_profiler_on %}{% endblock %}

{# profiling.transfer_timeout_probe: one extra run before the first pass,
   outside the counted iterations and every timing bracket, with the profiler
   off. Its waits give up after one check, so a dma unit still in flight times
   out (301) and the provider's abort drains it; nsx-psram's pending reads are
   sampled the moment the run returns. The default budget is bound again, and
   model_init and one more run (the pool poisoned again) show the module
   recovered. A probe status other than 0 or 301, or a failed recovery step,
   fails the capture like a failed loop. #}
{% block engine_pass_preamble %}{% if transfer_timeout_probe %}
#ifdef HPX_AOT_TRANSFER
    {
        static const {{ aot_prefix }}_nsx_transfer_options_t hpx_probe_options = {1U, 0U};
        hpx_transfer_bind(&hpx_probe_options);{{ poison_pool("        ") }}
{{ self.engine_reset_inputs() }}
        const int32_t probe = {{ aot_prefix }}_model_run(&{{ aot_prefix }}_model_ctx);
        const uint32_t pending = nsx_psram_pending();
        const int32_t provider = {{ aot_prefix }}_nsx_transfer_last()->error;
{% if transport == "rtt" %}
        hpx_rtt_set_blocking();
{% endif %}
        hpx_printf("HPX_TRANSFER_PROBE=%ld,%ld\n", (long)probe, (long)provider);
        // Each recovery step is checked before the next is taken; a step not
        // taken reports -1.
        const int32_t bind = {{ aot_prefix }}_nsx_transfer_bind(&{{ aot_prefix }}_model_ctx, nullptr);
        if (bind != 0) {
            hpx_transfer_print_recovery(bind, -1, -1, pending);
            hpx_transfer_bind_failed(bind);
        }
        const int32_t init = {{ aot_prefix }}_model_init(&{{ aot_prefix }}_model_ctx);
        if (init != 0) {
            hpx_transfer_print_recovery(bind, init, -1, pending);
            hpx_printf("HPX_ERROR=model_init_failed:%ld\n", (long)init);
            hpx_park();
        }{{ poison_pool("        ") }}
{{ self.engine_reset_inputs() }}
        const int32_t run = {{ aot_prefix }}_model_run(&{{ aot_prefix }}_model_ctx);
        hpx_transfer_print_recovery(bind, init, run, pending);
        // The recovery run's bytes: a piece the abort left to land late, or a
        // unit not copied again, shows against the reference capture here.
        for (int i = 0; i < {{ aot_prefix }}_num_outputs; i++) {
            hpx_printf("HPX_TRANSFER_RECOVERY_OUTPUT_%d_FNV1A64=%016llx\n", i,
                       (unsigned long long)hpx_fnv1a64({{ aot_prefix }}_model_ctx.outputs[i].data,
                                                       (size_t){{ aot_prefix }}_model_ctx.outputs[i].size));
        }
        hpx_aot_status = (probe != 0 && probe != 301) ? probe : run;
        hpx_aot_check_runs();
{% if transport == "rtt" %}
        hpx_rtt_set_nonblocking();
{% endif %}
    }
#endif
{% endif %}{{ super() }}{% endblock %}

{% block engine_profiled_run_done %}
#ifdef HPX_AOT_TRANSFER
        hpx_transfer_after_run();
#endif
{%- endblock %}

{% block engine_pass_init %}
{% if has_ethos_u | default(false) %}
    // Only the ethos_npu pass leaves NPU PMU tracking enabled; every other
    // pass must not accumulate stale counters from a prior ethos_npu pass.
    hpx_npu_set_enabled({{ "true" if pass.group == "ethos_npu" else "false" }});
{% endif %}
{% if pass.group == "ethos_npu" %}
    {
        // Ethos-U PMU pass: counters live in the NPU and are sampled by the
        // driver inference hooks (_npu_pmu.j2). The operator callback still
        // tracks layer ordinals/tags so rows align with ARM-PMU presets, but
        // no ARM counters are programmed. Names ARE the driver's symbolic
        // event enum.
        static const enum ethosu_pmu_event_type _pass{{ loop.index0 }}_npu_events[] = { {{ pass.counter_names | join(', ') }} };
        static const char* _pass{{ loop.index0 }}_names[] = { {% for name in pass.counter_names %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
        profiler_init_custom(nullptr, 0);
        hpx_npu_configure(_pass{{ loop.index0 }}_npu_events, _pass{{ loop.index0 }}_names, {{ pass.num_counters }});
    }
{% elif has_armv8m_pmu %}
    {
        static const uint32_t _pass{{ loop.index0 }}_ids[] = { {{ pass.event_ids | join(', ') }} };
        static const char* _pass{{ loop.index0 }}_names[] = { {% for name in pass.counter_names %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
        profiler_init_custom(_pass{{ loop.index0 }}_ids, {{ pass.num_counters }});
        profiler_set_counter_names(_pass{{ loop.index0 }}_names, {{ pass.num_counters }});
    }
{% else %}
    profiler_init_custom(nullptr, 0);
{% endif %}
{%- endblock %}

{% block engine_pass_warmup_arm %}
    g_profiler_enabled = false;
{%- endblock %}

{% block engine_pass_profile_arm %}
    g_profiler_enabled = true;
{%- endblock %}

{% block engine_iteration_setup %}
        profiler_clear();
{% if pass.group == "ethos_npu" %}
        hpx_npu_clear();
{% endif %}
        g_hb_pass = {{ loop.index0 }};
        g_hb_iter = iter;
        g_hb_last_cyc = DWT->CYCCNT;
        g_hb_ops_since = 0;
#ifdef HPX_AOT_TRANSFER
        hpx_transfer_run_start();
#endif{% if stream_evidence %}
        // profiling.stream_evidence: every run starts from a poisoned stream
        // pool and with each PSRAM constant arena cleaned and invalidated, so
        // a late or missing copy shows in the outputs and every constant read
        // reaches the MSPI controller.{{ poison_pool("        ") }}
{% for region in arena_regions if region.placement == "psram" and region.role == "constant" %}
        {
            am_hal_cachectrl_range_t hpx_range = {(uint32_t)(uintptr_t)hpx_arena_buf_{{ region.region_id }}, {{ region.size }}U};
            (void)am_hal_cachectrl_dcache_invalidate(&hpx_range, true);
        }
{% endfor %}{% endif %}
{%- endblock %}

{% block engine_print_csv %}        if (g_layer_capacity_exceeded) {
            hpx_printf("HPX_ERROR=operator_count_exceeds_capacity capacity=%d\n",
                       kMaxLayers);
            hpx_park();
        }
{% if pass.group == "ethos_npu" %}
        hpx_npu_print_csv();
{% else %}
        profiler_print_csv();
{% endif %}
#ifdef HPX_AOT_TRANSFER
        hpx_transfer_report();
#endif
        hpx_print_output_digests();
{%- endblock %}

{% block engine_profiled_summary %}
{% if has_ethos_u | default(false) %}
    // Passes are done; leave NPU PMU tracking disabled rather than armed on
    // whatever group happened to run last.
    hpx_npu_set_enabled(false);
{% endif %}
{% if transport == "rtt" %}
    hpx_rtt_set_blocking();
{% endif %}
    // The last run's outputs in full, then the inputs every run received.
    for (int i = 0; i < {{ aot_prefix }}_num_outputs; i++) {
        if ((size_t){{ aot_prefix }}_model_ctx.outputs[i].size > 1024U) {
            continue;
        }
        if ((size_t){{ aot_prefix }}_model_ctx.outputs[i].size == 0U) {
            hpx_printf("HPX_OUTPUT_%d_HEX=-\n", i);
            continue;
        }
        const uint8_t *bytes = (const uint8_t *){{ aot_prefix }}_model_ctx.outputs[i].data;
        hpx_printf("HPX_OUTPUT_%d_HEX=", i);
        for (size_t b = 0; b < (size_t){{ aot_prefix }}_model_ctx.outputs[i].size; b++) {
            hpx_printf("%02x", (unsigned)bytes[b]);
        }
        hpx_printf("\n");
    }
{{ self.engine_reset_inputs() }}
    for (int i = 0; i < {{ aot_prefix }}_num_inputs; i++) {
        hpx_printf("HPX_INPUT_%d_FNV1A64=%016llx\n", i,
                   (unsigned long long)hpx_fnv1a64({{ aot_prefix }}_model_ctx.inputs[i].data,
                                                   (size_t){{ aot_prefix }}_model_ctx.inputs[i].size));
    }
{{ super() }}{% endblock %}
