        am_hal_burst_mode_e burst_state = AM_HAL_NORMAL_MODE;
        am_hal_burst_mode_initialize(&burst_avail);
        if (burst_avail == AM_HAL_BURST_AVAIL) {
            am_hal_burst_mode_enable(&burst_state);
        }
        hpx_burst_avail = (burst_avail == AM_HAL_BURST_AVAIL);
        hpx_burst_engaged = (burst_state == AM_HAL_BURST_MODE);
        if (hpx_burst_engaged) {
