    // --- Apollo3/3P TurboSPOT (96 MHz burst) ------------------------------
    // NSX exposes no perf-mode selector on Apollo3, so request burst directly
    // through the AmbiqSuite HAL.  Burst raises ONLY the CPU clock, so mirror
    // it into SystemCoreClock to keep every device-side cycle->time value (and
    // the host's registry clock assumption) consistent.  If burst is
    // unavailable the host's device-clock cross-check flags the mismatch.
    int hpx_burst_avail = 0;
    int hpx_burst_engaged = 0;
    {
