            hpx_printf("HPX_CLEAN_DWT_RATE_US=%lu\n",
                       (unsigned long)HPX_CLEAN_DWT_RATE_PROBE_US);
{%- if clean_window_needs_probe_attach | default(false) and transport == "rtt" and not power_only | default(false) %}
            hpx_printf("HPX_CLEAN_ATTACH_WAIT_US=%lu\n",
                       (unsigned long)clean_attach_wait_us);
{%- endif %}
{%- endif %}
            if (SystemCoreClock > 0U) {
                const uint32_t clean_avg_us = (uint32_t)(
                    ((uint64_t)clean_avg_cycles * 1000000ULL +
                     ((uint64_t)SystemCoreClock / 2ULL)) /
                    (uint64_t)SystemCoreClock);
                hpx_printf("HPX_CLEAN_INFER_AVG_US=%lu\n",
                           (unsigned long)clean_avg_us);
            }
{% endif %}
        }{% endblock %}
{% if power_only | default(false) %}
{% include "_power_terminal_success.j2" with context %}
{% endif %}
    }

{% if power_only | default(false) %}
{% else %}{% if transport == "rtt" %}
    // Boot header was captured losslessly; restore droppable writes for the
    // timed window so an in-flight heartbeat can never stall the timed
    // inference call.
    hpx_rtt_set_nonblocking();
{% if power_sync_enabled %}
    // This build ran a gated power/clean window (external power capture): the
    // host is watching the GPIO gate via a separate instrument, not draining
    // RTT, so treat "host absent" as the expected case for everything printed
    // from here on, not a rare dead-host edge case.  See
    // HPX_RTT_LOSSLESS_TIMEOUT_POST_WINDOW_MS in _hpx_printf.j2.
    hpx_rtt_shorten_lossless_timeout();
{% endif %}
{% endif %}
    // --- Multi-pass PMU profiling ---{% block engine_pass_preamble %}
    // Each pass configures a specific set of PMU counters.  When the user
    // requests more counters than fit in a single pass (4 with 32-bit
    // chaining), the profiler runs multiple passes and the host merges
    // the results.  Warmup iterations are repeated per-pass to ensure
    // stable cache / pipeline state.{% endblock %}
{% for pass in pmu_passes %}
    hpx_printf("\n--- HPX_PRESET {{ pass.name }} ---\n");{% block engine_pass_init scoped %}{% endblock %}

{% if transport == "usb_cdc" %}
    usb_timer_pause();
{% endif %}

    // Warmup for this pass (profiler disabled, no GPIO sync){% block engine_pass_warmup_arm scoped %}{% endblock %}
    for (int w = 0; w < {{ warmup }}; w++) {
{{ self.engine_reset_inputs() }}
        {{ self.engine_invoke() }}
    }
    hpx_printf("HPX_HEARTBEAT phase=warmup_done pass={{ loop.index0 }}\n");

    // Profiled iterations — per-layer PMU instrumentation (no GPIO sync; the
    // clean pass above owns the external-power window).{% block engine_pass_profile_arm scoped %}{% endblock %}
    for (int iter = 0; iter < {{ iterations }}; iter++) {
{{ self.engine_reset_inputs() }}{% block engine_iteration_setup scoped %}{% endblock %}

        uint32_t infer_start_cyc = DWT->CYCCNT;
        {{ self.engine_invoke() }}
        profiled_infer_cycles += (uint32_t)(DWT->CYCCNT - infer_start_cyc);
        profiled_infer_count++;

{% if transport == "usb_cdc" %}
        usb_timer_resume();
{% elif transport == "rtt" %}
        // CSV dump is outside the timed window — make it lossless.
        hpx_rtt_set_blocking();
{% endif %}
        hpx_printf("\n--- HPX_ITER %d ---\n", iter);
{% block engine_print_csv scoped %}{% endblock %}
{% if transport == "usb_cdc" %}
        usb_timer_pause();
{% elif transport == "rtt" %}
        // Restore non-blocking before the next timed inference call so
        // heartbeats emitted mid-inference can never stall and skew
        // measurements.
        hpx_rtt_set_nonblocking();
{% endif %}
    }

{% if transport == "usb_cdc" %}
    usb_timer_resume();
{% endif %}
{# engine_profiled_summary -- the HPX_PROFILED_INFER_* wire lines derived from
   the per-pass loop's DWT bracket around self.engine_invoke().  A region block
   (anchor glued to the endfor above, content leading with its own newline), so
   an engine whose invoke is not a pure inference call can override it empty and
   emit nothing at all rather than emitting the same keys with different
   semantics.  The profiled_infer_cycles/count accumulation in the loop is
   unconditional and stays that way -- it is cheap, and keeping it out of the
   seam keeps the loop identical for every engine. #}{% endfor %}{% block engine_profiled_summary %}

    if (profiled_infer_count > 0 && SystemCoreClock > 0U) {
        const uint32_t profiled_infer_total_us = (uint32_t)(
            (profiled_infer_cycles * 1000000ULL + ((uint64_t)SystemCoreClock / 2ULL)) /
            (uint64_t)SystemCoreClock);
        const uint32_t profiled_infer_avg_us = (uint32_t)(
            (profiled_infer_cycles * 1000000ULL +
             (((uint64_t)SystemCoreClock * (uint64_t)profiled_infer_count) / 2ULL)) /
            ((uint64_t)SystemCoreClock * (uint64_t)profiled_infer_count));
        hpx_printf("HPX_PROFILED_INFER_COUNT=%lu\n", (unsigned long)profiled_infer_count);
        hpx_printf("HPX_PROFILED_INFER_TOTAL_US=%lu\n", (unsigned long)profiled_infer_total_us);
        hpx_printf("HPX_PROFILED_INFER_AVG_US=%lu\n", (unsigned long)profiled_infer_avg_us);
    }{% endblock %}

{% if transport == "rtt" %}
    // All timed inference work is done — switch to lossless blocking mode so
    // the final sentinel can never be dropped, then flush and drain as a
    // belt-and-braces measure.  Emit a phase heartbeat so the host inactivity
    // timer refreshes while we drain.
    hpx_rtt_set_blocking();
    hpx_printf("HPX_HEARTBEAT phase=flushing\n");
    HPX_CLEAN_DCACHE();
    hpx_rtt_drain(500 /* ms */);
{% endif %}
    hpx_printf("\n--- HPX_END ---\n");
{% if transport == "rtt" %}
    HPX_CLEAN_DCACHE();
    hpx_rtt_drain(500 /* ms */);
{% endif %}{% endif %}
    hpx_park();
    return 0;
}
