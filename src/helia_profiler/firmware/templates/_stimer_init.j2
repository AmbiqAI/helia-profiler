{# _stimer_init.j2 — STIMER (XTAL 32.768 kHz) clean-window clock.

   Used instead of DWT->CYCCNT to time the silent clean/power window wherever
   the binary cannot rely on the CoreSight debug power domain staying up:
   Apollo5 always (ClockCapabilities.clean_window_timer == "stimer"), and every
   Cortex-M4F (Apollo3/3P, Apollo4/4P/4L) dedicated power binary -- AP4's broad
   peripheral shutdown disables that domain outright, and both families' power
   binaries free-run with no debugger asserting CDBGPWRUPREQ to hold it up.
   See SocCapabilities.power_window_timer.  STIMER is clock-mode-independent
   (own XTAL) and, critically, keeps ticking with the debug domain powered off.

   Apollo3/3P validity: am_hal_stimer_config / am_hal_stimer_counter_get and
   the AM_HAL_STIMER_XTAL_32KHZ / CFG_CLEAR / CFG_RUN literals all exist in the
   apollo3 and apollo3p HALs, and this exact two-call sequence is what
   AmbiqSuite's own apollo3p STIMER widget uses (CFG_RUN is 0 there --
   CTIMER_STCFG_CLEAR_RUN -- so the second write both selects the clock and
   releases the counter from reset).
#}
// STIMER cycle-independent wall clock for the clean/power window.
#define HPX_STIMER_HZ 32768U

// Settle-and-verify budget.  AM_HAL_STIMER_CFG_CLEAR drops the XT request and
// the crystal restarts (Apollo4 datasheet 6.4: "the XT is only enabled when an
// internal module is using it").  Bench-measured cold on Apollo4 Blue Plus
// (issue #124): 25 ms and 100 ms settles read garbage, at 400 ms the first
// 250 ms measurement is still in the transient while the second is settled,
// and 750 ms repeats to tens of ppm -- so the transient ends somewhere in the
// 400-650 ms the 400 ms row brackets.
//
// A FIXED delay was rejected: it would tax every power run for a transient
// that usually does not happen, because the XT is normally already running by
// the time a window opens (which is why production 5 s windows measured 0.064%
// against the JS110 gate despite this hazard).  Verify instead, and pay only
// when the crystal really is cold.
//
// The reference is nsx_delay_us, a calibrated BOOTROM cycle loop -- no DWT, no
// debug domain -- so it cannot share this clock's fault.  Same construction as
// the clean window's DWT rate probe (#121), inverted.
//
// Acceptance needs TWO consecutive in-band probes, not one.  The same bench
// data shows why: the 400 ms row's first reading implies STIMER running ~36%
// fast (446 apparent ticks against the 410 ceiling -- only 8.9% of headroom),
// so a single-probe accept has a blind band just above the ceiling where a
// still-ramping crystal squeaks through; and consecutive readings DISAGREEING
// is exactly the unsettled signature that made the #124 sweep trustworthy.
// Two probes make the ramp show itself.  Band is 245..410 ticks around the
// 327.68 nominal (-25.2% / +25.1%; integer tick bounds, so not exactly 25).
#define HPX_STIMER_SETTLE_PROBE_US   10000U   // 10 ms -> 327.68 ticks nominal
#define HPX_STIMER_SETTLE_MIN_TICKS  245U     // ~-25%: rejects a stopped/slow XT
#define HPX_STIMER_SETTLE_MAX_TICKS  410U     // ~+25%: rejects transient overshoot
#define HPX_STIMER_SETTLE_MAX_US     1000000U // 1 s deadline, ~1.5x the measured worst case

// Returns 1 when two consecutive probes landed in band (crystal settled and
// plausible), 0 when the deadline expired with the crystal still unfit.  On
// 0 the caller emits HPX_ERROR=stimer_dead BEFORE the window opens (#110's
// remaining half): without that attribution a dead 32.768 kHz XTAL completes
// the window, yields elapsed_us == 0, and is indistinguishable on the bench
// from the debug-domain frozen-clock bug #106/#107 fixed.  Warm cost: two
// 10 ms probes per init; the failure emission is fault-path only.
static inline uint32_t hpx_stimer_init(void) {
    am_hal_stimer_config(AM_HAL_STIMER_CFG_CLEAR);
    am_hal_stimer_config(AM_HAL_STIMER_XTAL_32KHZ | AM_HAL_STIMER_CFG_RUN);

    uint32_t settle_spent_us = 0U;
    uint32_t settle_in_band = 0U;
    while (settle_spent_us < HPX_STIMER_SETTLE_MAX_US) {
        const uint32_t settle_t0 = am_hal_stimer_counter_get();
        nsx_delay_us(HPX_STIMER_SETTLE_PROBE_US);
        const uint32_t settle_ticks =
            (uint32_t)(am_hal_stimer_counter_get() - settle_t0);
        settle_spent_us += HPX_STIMER_SETTLE_PROBE_US;
        if (settle_ticks >= HPX_STIMER_SETTLE_MIN_TICKS &&
            settle_ticks <= HPX_STIMER_SETTLE_MAX_TICKS) {
            settle_in_band++;
            if (settle_in_band >= 2U) {
                return 1U;
            }
        } else {
            settle_in_band = 0U;
        }
    }
    return 0U;
}

static inline uint32_t hpx_stimer_ticks(void) {
    return am_hal_stimer_counter_get();
}

// ticks -> microseconds.  32768 ticks/s -> us = ticks * 1,000,000 / 32768.
static inline uint64_t hpx_stimer_ticks_to_us(uint64_t ticks) {
    return (ticks * 1000000ULL) / (uint64_t)HPX_STIMER_HZ;
}
