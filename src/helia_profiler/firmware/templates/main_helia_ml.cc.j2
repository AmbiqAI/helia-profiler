// re-inclusion is a harmless no-op (avoids overload conflicts with GCC 14).
#if defined(__ARM_FEATURE_MVE)
#include <arm_mve.h>
#endif

// heliaML generated module API ({{ aot_prefix }}_model_init / _model_run).
#include "{{ engine_header }}"

