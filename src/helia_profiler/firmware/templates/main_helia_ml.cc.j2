// engine templates (see main_aot.cc.j2 for the full comments).
#define HPX_SWO_SYNC_PREAMBLE_LINES  40
#define HPX_SWO_SYNC_GAP_US          (20U * 1000U)
#define HPX_USB_POLL_DELAY_US     (10U * 1000U)
#define HPX_USB_SETTLE_DELAY_US   (200U * 1000U)
