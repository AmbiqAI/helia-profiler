{% extends "_main_base.cc.j2" %}
{#- main_helia_ml.cc — heliaPROFILER firmware entry point for heliaML.

   The firmware skeleton -- boot, transport preamble, GPIO sync, clean-window
   machinery, PMU pass loop, teardown -- lives in _main_base.cc.j2; this
   template only fills in the engine_* blocks.  Read that file's prelude for
   the whitespace contract the block shapes follow.

   heliaML is traditional ML: the whole model is ONE public call with no
   operator graph, no interpreter, and no arena to bind.  This is therefore
   the SIMPLEST child of the base, simpler than heliaAOT and ExecuTorch on
   purpose:

     * engine_clean_window is NOT overridden.  The generated module's
       `run` entry point IS the inference -- no per-call model load
       (ExecuTorch's reason to override) and no operator callbacks to
       quiesce -- so the base's default window, which brackets
       self.engine_invoke() with the window clock, measures exactly the
       right thing.
     * engine_profiled_summary is NOT overridden, for the same reason:
       the DWT bracket around engine_invoke() times a genuine inference,
       so HPX_PROFILED_INFER_* keeps the same execute-only semantics the
       other engines report.
     * The per-layer table collapses to ONE row per iteration
       ("model_run:0").  Anything per-op would be an invention, not a
       measurement.

   Weights are `static const` arrays inside the linked generated module
   (heliaml.write() emitted them into the params header), so there is no
   model blob to embed and no HPX_MODEL_SIZE / HPX_ARENA_SIZE to report --
   the wire registry scopes those to the interpreter engines.  PSRAM
   placement is refused in preflight for the same reason (the weights are
   flash-resident by construction), so engine_pre_start stays at the base's
   empty default and engine_psram_metadata is overridden empty. #}

{% block engine_file_header %}
/**
 * @file main.cc
 * @brief heliaPROFILER firmware (heliaML) — auto-generated, do not edit.
 *
 * Times the generated heliaML module's run entry point end-to-end and
 * emits exactly one PMU row per iteration ("model_run:0") over
 * {{ transport | upper }} for the host-side capture stage to parse.
 */
{%- endblock %}

{% block engine_includes %}
// heliaML generated module API ({{ aot_prefix }}_model_init / _model_run).
#include "{{ engine_header }}"
{% if has_armv8m_pmu %}
{# nsx_pmu_utils.h is the nsx_pmu_* config/counter API the whole-model
   bracket drives directly, exactly as heliaAOT's operator callback and
   ExecuTorch's end_operator hook do.  Gated the same way those children
   gate it so the umbrella HAL header can never be pulled in twice or, on
   a part without the Armv8-M PMU, at all. #}
#include "nsx_pmu_utils.h"
{% endif %}
{%- endblock %}

{# One whole-model record: four counters and an overflow flag, a few dozen
   bytes of ordinary .bss.  There is no per-layer array to keep SRAM-resident,
   so the profile binary skips the SSRAM power-on the interpreter engines
   need for theirs (#161's child-declared fact, declared honestly). #}
{% block engine_pmu_storage_sram_resident %}false{% endblock %}

{% block engine_model_storage %}
// No embedded model blob: the weights are `static const` arrays compiled
// into the linked generated module.  Nothing to include here.
{%- endblock %}

{% block engine_globals %}
// ---------------------------------------------------------------------------
// Whole-model PMU capture — ONE record per inference, no per-op table.
// ---------------------------------------------------------------------------
static constexpr int kMaxEvents = 4;

{% if has_armv8m_pmu %}
static nsx_pmu_config_t g_pmu_cfg;
{% endif %}
static uint32_t g_run_counters[kMaxEvents];
static bool g_run_overflow = false;
static int g_num_counters = 0;
static const char *g_counter_names[kMaxEvents] = {};
static bool g_profile_enabled = false;

// Heartbeat state — one "op" per inference, so cadence is per-iteration.
static uint32_t g_hb_every_cyc = 0;
static int      g_hb_every_ops = 0;
static uint32_t g_hb_last_cyc = 0;
static int      g_hb_ops_since = 0;
static int      g_hb_pass = 0;
static int      g_hb_iter = 0;

{% if has_armv8m_pmu %}
static void profiler_set_counter_names(const char *const names[], int num_names) {
    int limit = (num_names > kMaxEvents) ? kMaxEvents : num_names;
    for (int i = 0; i < limit; i++) {
        g_counter_names[i] = names[i];
    }
    for (int i = limit; i < kMaxEvents; i++) {
        g_counter_names[i] = nullptr;
    }
}

static void profiler_init_preset(nsx_pmu_preset_e preset) {
    nsx_pmu_reset_config(&g_pmu_cfg);
    g_pmu_cfg.api = &nsx_pmu_V1_0_0;
    nsx_pmu_apply_preset(&g_pmu_cfg, preset);
    nsx_pmu_init(&g_pmu_cfg);
    g_num_counters = 0;
    for (int i = 0; i < kMaxEvents; i++) {
        if (g_pmu_cfg.events[i].enabled) g_num_counters++;
    }
}

static void profiler_init_custom(const uint32_t event_ids[], int num_events) {
    nsx_pmu_reset_config(&g_pmu_cfg);
    g_pmu_cfg.api = &nsx_pmu_V1_0_0;
    int n = (num_events > kMaxEvents) ? kMaxEvents : num_events;
    for (int i = 0; i < n; i++) {
        nsx_pmu_event_create(&g_pmu_cfg.events[i], event_ids[i],
                            NSX_PMU_EVENT_COUNTER_SIZE_32);
    }
    nsx_pmu_init(&g_pmu_cfg);
    g_num_counters = n;
}

static void profiler_run_begin(void) {
    uint32_t saved_cyccnt = DWT->CYCCNT;
    nsx_pmu_reset_counters();
    DWT->CYCCNT = saved_cyccnt;
#if (__CORTEX_M >= 55U)
    ARM_PMU_Set_CNTR_OVS(0xFFFFFFFFU);
#endif
}

static void profiler_run_end(void) {
    uint32_t saved_cyccnt = DWT->CYCCNT;
    nsx_pmu_get_counters(&g_pmu_cfg);
    DWT->CYCCNT = saved_cyccnt;
    for (int i = 0; i < g_num_counters; i++) {
        g_run_counters[i] = g_pmu_cfg.counter[i].counterValue;
    }
#if (__CORTEX_M >= 55U)
    uint32_t ovs = ARM_PMU_Get_CNTR_OVS();
    g_run_overflow = (ovs != 0);
    if (ovs) ARM_PMU_Set_CNTR_OVS(ovs);
#else
    g_run_overflow = false;
#endif
}
{% else %}
static uint32_t g_run_start_cyccnt = 0;

static void profiler_init_preset(int) { g_num_counters = 1; }
static void profiler_init_custom(const uint32_t[], int) { profiler_init_preset(0); }
static void profiler_run_begin(void) { g_run_start_cyccnt = DWT->CYCCNT; }
static void profiler_run_end(void) {
    g_run_counters[0] = DWT->CYCCNT - g_run_start_cyccnt;
    g_run_overflow = false;
}
{% endif %}

static void profiler_print_csv(void) {
    hpx_printf("\"Layer\",\"Op\"");
{% if has_armv8m_pmu %}
    for (int e = 0; e < g_num_counters; e++) {
        if (!g_pmu_cfg.events[e].enabled) break;
        if (g_counter_names[e] != nullptr)
            hpx_printf(",\"%s\"", g_counter_names[e]);
        else
            hpx_printf(",\"0x%04lx\"", (unsigned long)g_pmu_cfg.events[e].eventId);
    }
{% else %}
    hpx_printf(",\"ARM_PMU_CPU_CYCLES\"");
{% endif %}
    hpx_printf(",\"overflow\"\n");
    // One row: the whole model is one call.  "model_run:0" is the stable
    // op label the host groups on.
    hpx_printf("0,model_run:0");
    for (int e = 0; e < g_num_counters; e++) {
{% if has_armv8m_pmu %}
        if (!g_pmu_cfg.events[e].enabled) break;
{% endif %}
        hpx_printf(",%lu", (unsigned long)g_run_counters[e]);
    }
    hpx_printf(",%d\n", g_run_overflow ? 1 : 0);
}

// ---------------------------------------------------------------------------
// Model buffers — sized by the generated module's own dimension macros.
// Inputs are zeros, matching the other engine templates: this profiles
// the kernel, not a dataset.
// ---------------------------------------------------------------------------
static float hpx_input[{{ aot_prefix | upper }}_INPUT_COUNT];
{% if helia_ml_run_shape == "scores" %}
static float hpx_scores[{{ aot_prefix | upper }}_OUTPUT_COUNT];
static size_t hpx_out_class = 0u;
{% elif helia_ml_run_shape == "class" %}
static size_t hpx_out_class = 0u;
{% else %}
static float hpx_out_value = 0.0f;
{% endif %}

static inline heliaml_status_t hpx_model_run(void) {
{% if helia_ml_run_shape == "scores" %}
    return {{ aot_prefix }}_model_run(hpx_input, hpx_scores, &hpx_out_class);
{% elif helia_ml_run_shape == "class" %}
    return {{ aot_prefix }}_model_run(hpx_input, &hpx_out_class);
{% else %}
    return {{ aot_prefix }}_model_run(hpx_input, &hpx_out_value);
{% endif %}
}

// One parameterless run wrapper for every base call site (warmup, clean
// window, profiled loop).  Whether a run is PMU-bracketed is read from
// g_profile_enabled (armed by engine_pass_warmup_arm /
// engine_pass_profile_arm / engine_profiler_off) so the bracket hugs the
// call exactly — the base's post-invoke seams sit after transport
// switches, which must never land inside the measured counters.
static void profiled_model_run(void) {
    if (!g_profile_enabled) {
        (void)hpx_model_run();
        return;
    }
    profiler_run_begin();
    (void)hpx_model_run();
    profiler_run_end();

    // Heartbeat emission — counters are already latched, so the printf
    // cost lands after the record, exactly as in the per-op engines'
    // callbacks.  One "op" per inference: layer is always 1.
    ++g_hb_ops_since;
    const bool by_ops = (g_hb_every_ops > 0) &&
                        (g_hb_ops_since >= g_hb_every_ops);
    bool by_time = false;
    if (g_hb_every_cyc > 0) {
        uint32_t now = DWT->CYCCNT;
        uint32_t delta = now - g_hb_last_cyc;
        by_time = (delta >= g_hb_every_cyc);
    }
    if (by_ops || by_time) {
        hpx_printf("HPX_HEARTBEAT phase=infer pass=%d iter=%d layer=%d\n",
                   g_hb_pass, g_hb_iter, 1);
        g_hb_last_cyc = DWT->CYCCNT;
        g_hb_ops_since = 0;
    }
}
{%- endblock %}

{% block engine_heartbeat_arm %}
    // --- Heartbeat config (matches the other engine templates for protocol
    // consistency; one "op" per inference, so cadence is per-iteration) ---
    static constexpr bool     kHbEnabled   = {{ heartbeat_enabled | lower }};
    static constexpr int      kHbEveryNOps = {{ heartbeat_every_n_ops }};
    static constexpr uint32_t kHbEveryMs   = {{ heartbeat_every_ms }};
    hpx_printf("HPX_HEARTBEAT_ENABLED=%d\n", (int)kHbEnabled);
    hpx_printf("HPX_HEARTBEAT_EVERY_N_OPS=%d\n", kHbEveryNOps);
    hpx_printf("HPX_HEARTBEAT_EVERY_MS=%lu\n", (unsigned long)kHbEveryMs);
    g_hb_every_cyc = (kHbEnabled && kHbEveryMs > 0)
        ? (uint32_t)((uint64_t)SystemCoreClock / 1000U * kHbEveryMs)
        : 0U;
    g_hb_every_ops = kHbEnabled ? kHbEveryNOps : 0;

    hpx_printf("HPX_HEARTBEAT phase=init\n");
{%- endblock %}

{% block engine_model_setup %}
    // Initialize the generated module (validates the compiled-in model).
    {
        const heliaml_status_t init_status = {{ aot_prefix }}_model_init();
        if (init_status != HELIAML_STATUS_OK) {
            hpx_printf("HPX_ERROR=model_init_failed:%d\n", (int)init_status);
{% if power_only | default(false) %}
            hpx_power_terminal_fail("model_init", 6U);
{% else %}
            hpx_park();
{% endif %}
        }
    }
    hpx_printf("HPX_HEARTBEAT phase=model_init_done\n");
{%- endblock %}

{% block engine_io_metadata %}
    // One input vector, one output surface — indexed form for parser
    // consistency with heliaAOT's compiled-in-weights token shapes.
    hpx_printf("HPX_INPUT_%d_SIZE=%d\n", 0, (int)sizeof(hpx_input));
{% if helia_ml_run_shape == "scores" %}
    hpx_printf("HPX_OUTPUT_%d_SIZE=%d\n", 0, (int)sizeof(hpx_scores));
{% elif helia_ml_run_shape == "class" %}
    hpx_printf("HPX_OUTPUT_%d_SIZE=%d\n", 0, (int)sizeof(hpx_out_class));
{% else %}
    hpx_printf("HPX_OUTPUT_%d_SIZE=%d\n", 0, (int)sizeof(hpx_out_value));
{% endif %}
{%- endblock %}

{% block engine_profiler_off %}        g_profile_enabled = false;{% endblock %}{% block engine_psram_metadata %}
{# heliaML has no PSRAM support (weights are flash-resident by construction
   and preflight refuses the placement), so the base's metadata include must
   not render — it references psram_info, undeclared in these renders (the
   same #171 uncompilable-render class ExecuTorch's override closes).
   Deliberately empty. #}{% endblock %}

{% block engine_reset_inputs_warm %}            memset(hpx_input, 0, sizeof(hpx_input));{% endblock %}

{% block engine_reset_inputs %}        memset(hpx_input, 0, sizeof(hpx_input));{% endblock %}

{% block engine_invoke %}profiled_model_run();{% endblock %}

{% block engine_pass_init %}
{% if has_armv8m_pmu and pass.custom %}
    {
        static const uint32_t _pass{{ loop.index0 }}_ids[] = { {{ pass.event_ids | join(', ') }} };
        static const char *_pass{{ loop.index0 }}_names[] = { {% for name in pass.counter_names %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
        profiler_init_custom(_pass{{ loop.index0 }}_ids, {{ pass.num_counters }});
        profiler_set_counter_names(_pass{{ loop.index0 }}_names, {{ pass.num_counters }});
    }
{% elif has_armv8m_pmu %}
    {
        static const char *_pass{{ loop.index0 }}_names[] = { {% for name in pass.counter_names %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
        profiler_init_preset({{ pass.c_enum }});
        profiler_set_counter_names(_pass{{ loop.index0 }}_names, {{ pass.num_counters }});
    }
{% else %}
    profiler_init_preset(0);
{% endif %}
{%- endblock %}

{% block engine_pass_warmup_arm %}
    g_profile_enabled = false;
{%- endblock %}

{% block engine_pass_profile_arm %}
    g_profile_enabled = true;
{%- endblock %}

{% block engine_iteration_setup %}
        g_hb_pass = {{ loop.index0 }};
        g_hb_iter = iter;
        g_hb_last_cyc = DWT->CYCCNT;
        g_hb_ops_since = 0;
{%- endblock %}

{% block engine_print_csv %}        profiler_print_csv();{% endblock %}
